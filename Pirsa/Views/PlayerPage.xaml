<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Pirsa.Views.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:Pirsa.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vlc="using:LibVLCSharp.Platforms.Windows"
    xmlns:views="using:Pirsa.Views"
    xmlns:vm="using:Pirsa.ViewModels"
    x:DefaultBindMode="OneWay"
    Background="{ThemeResource PlayerSurfaceBrush}"
    KeyboardAcceleratorPlacementMode="Hidden"
    NavigationCacheMode="Disabled"
    RequestedTheme="Dark"
    mc:Ignorable="d">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F" Invoked="FullscreenAccelerator_Invoked" />
        <KeyboardAccelerator Key="M" Invoked="MuteAccelerator_Invoked" />
        <KeyboardAccelerator Key="Escape" Invoked="EscapeAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Page.Resources>
        <Style x:Key="SubtitleListItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="SubtitleTimingButtonStyle" TargetType="RepeatButton">
            <Setter Property="Width" Value="104" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="{ThemeResource PlayerControlBackgroundBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource PlayerForegroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Delay" Value="400" />
            <Setter Property="Interval" Value="80" />
        </Style>
        <DataTemplate x:Key="SubtitleLanguageTemplate" x:DataType="vm:SubtitleLanguageChoice">
            <StackPanel Spacing="1">
                <TextBlock
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource PlayerForegroundBrush}"
                    Text="{x:Bind LanguageName}" />
                <TextBlock
                    FontSize="11"
                    Foreground="{ThemeResource PlayerSecondaryForegroundBrush}"
                    Text="{x:Bind Detail}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="SubtitleVersionTemplate" x:DataType="vm:SubtitleVersionChoice">
            <StackPanel Spacing="1">
                <TextBlock
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource PlayerForegroundBrush}"
                    Text="{x:Bind Label}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    MaxLines="2"
                    FontSize="11"
                    Foreground="{ThemeResource PlayerSecondaryForegroundBrush}"
                    Text="{x:Bind Detail}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>


        <DataTemplate x:Key="SourceGroupHeaderTemplate" x:DataType="vm:SourceListItem">
            <Grid Padding="4,12,4,4" ColumnSpacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        CharacterSpacing="50"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource PlayerForegroundBrush}"
                        Text="{x:Bind HeaderTitle}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{ThemeResource PlayerSecondaryForegroundBrush}"
                        Text="{x:Bind HeaderDetail}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SourceRowTemplate" x:DataType="vm:SourceListItem">
            <Grid Padding="2" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="52"
                    Height="52"
                    VerticalAlignment="Top"
                    Background="{ThemeResource PlayerBadgeBackgroundBrush}"
                    CornerRadius="8">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource PlayerBadgeForegroundBrush}"
                        Text="{x:Bind Source.QualityLabel}" />
                </Border>

                <StackPanel Grid.Column="1" Spacing="3">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            MaxLines="1"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource PlayerForegroundBrush}"
                            Text="{x:Bind Source.Title}"
                            TextTrimming="CharacterEllipsis" />
                        <Border
                            Grid.Column="1"
                            Padding="6,2"
                            VerticalAlignment="Center"
                            Background="{ThemeResource PlayerBadgeBackgroundBrush}"
                            CornerRadius="4"
                            Visibility="{x:Bind helpers:XamlHelpers.Visible(Source.IsCurrent)}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon
                                    FontSize="9"
                                    Foreground="{ThemeResource PlayerBadgeForegroundBrush}"
                                    Glyph="&#xE73E;" />
                                <TextBlock
                                    FontSize="10"
                                    Foreground="{ThemeResource PlayerBadgeForegroundBrush}"
                                    Text="Playing" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource PlayerSecondaryForegroundBrush}"
                        Text="{x:Bind Source.SubtitleLine}"
                        TextTrimming="CharacterEllipsis" />

                    <TextBlock
                        MaxLines="2"
                        FontSize="11"
                        Foreground="{ThemeResource PlayerTertiaryForegroundBrush}"
                        Text="{x:Bind Source.DetailsLine}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind helpers:XamlHelpers.Visible(Source.HasDetails)}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <views:SourceItemTemplateSelector
            x:Key="SourceItemTemplateSelector"
            HeaderTemplate="{StaticResource SourceGroupHeaderTemplate}"
            SourceTemplate="{StaticResource SourceRowTemplate}" />
    </Page.Resources>

    <Grid x:Name="Root" Background="{ThemeResource PlayerSurfaceBrush}">
        <vlc:VideoView
            x:Name="VideoSurface"
            AutomationProperties.Name="Video"
            IsTabStop="True"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Initialized="VideoSurface_Initialized" />

        <!--  Click surface for play/pause and waking the chrome  -->
        <Grid
            x:Name="InputLayer"
            Background="Transparent"
            PointerMoved="InputLayer_PointerMoved"
            Tapped="InputLayer_Tapped" />

        <!--  Playback chrome  -->
        <Grid
            x:Name="Chrome"
            IsHitTestVisible="False"
            Opacity="0">
            <Border
                Height="160"
                VerticalAlignment="Top"
                Background="{ThemeResource PlayerTopScrimBrush}"
                IsHitTestVisible="False" />
            <Border
                Height="280"
                VerticalAlignment="Bottom"
                Background="{ThemeResource PlayerBottomScrimBrush}"
                IsHitTestVisible="False" />

            <Grid
                Height="56"
                Margin="24,14,24,0"
                VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="OverlayBackButton"
                    AutomationProperties.Name="Back"
                    Click="Back_Click"
                    Style="{StaticResource PlayerIconButtonStyle}"
                    ToolTipService.ToolTip="Back"
                    Visibility="Collapsed">
                    <FontIcon FontSize="18" Glyph="&#xE72B;" />
                </Button>

                <StackPanel
                    Grid.Column="1"
                    Margin="12,0,20,0"
                    VerticalAlignment="Center">
                    <TextBlock
                        MaxLines="1"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource PlayerForegroundBrush}"
                        Text="{x:Bind ViewModel.Title}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        MaxLines="1"
                        FontSize="12"
                        Foreground="{ThemeResource PlayerSecondaryForegroundBrush}"
                        Text="{x:Bind ViewModel.Subtitle}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Button
                    x:Name="SourcesButton"
                    Grid.Column="2"
                    AutomationProperties.Name="Sources"
                    Click="OpenSources_Click"
                    Style="{StaticResource PlayerTextButtonStyle}"
                    ToolTipService.ToolTip="Choose a source">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="13" Glyph="&#xE8FD;" />
                        <TextBlock Text="{x:Bind ViewModel.SourcesLabel}" />
                    </StackPanel>
                </Button>
            </Grid>

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
                <Button
                    x:Name="CenterPlayButton"
                    AutomationProperties.Name="Play"
                    Click="PlayPause_Click"
                    Style="{StaticResource PlayerCenterButtonStyle}"
                    ToolTipService.ToolTip="Play / pause (Space)"
                    Visibility="Collapsed">
                    <FontIcon x:Name="CenterPlayIcon" FontSize="34" Glyph="&#xE768;" />
                </Button>
                <TextBlock
                    x:Name="EndedText"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource PlayerSecondaryForegroundBrush}"
                    Text="Playback finished"
                    Visibility="Collapsed" />
            </StackPanel>

            <StackPanel
                x:Name="BufferPanel"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="Collapsed">
                <ProgressRing
                    x:Name="BufferRing"
                    Width="44"
                    Height="44"
                    IsActive="False" />
                <TextBlock
                    x:Name="BufferText"
                    Foreground="{ThemeResource PlayerSecondaryForegroundBrush}"
                    Text="Buffering…" />
            </StackPanel>

            <Grid
                Margin="32,0,32,20"
                VerticalAlignment="Bottom">
                <StackPanel>
                    <Slider
                        x:Name="SeekSlider"
                        AutomationProperties.Name="Seek"
                        IsThumbToolTipEnabled="False"
                        Maximum="1"
                        Minimum="0"
                        ValueChanged="SeekSlider_ValueChanged" />

                    <Grid Height="48" Margin="0,-6,0,0">
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="2"
                            VerticalAlignment="Center">
                            <Button
                                x:Name="PlayPauseButton"
                                AutomationProperties.Name="Play"
                                Click="PlayPause_Click"
                                Style="{StaticResource PlayerIconButtonStyle}"
                                ToolTipService.ToolTip="Play / pause (Space)">
                                <FontIcon x:Name="PlayPauseIcon" FontSize="22" Glyph="&#xE768;" />
                            </Button>
                            <Button
                                AutomationProperties.Name="Back 10 seconds"
                                Click="Back10_Click"
                                Style="{StaticResource PlayerIconButtonStyle}"
                                ToolTipService.ToolTip="Back 10 seconds (Left arrow)">
                                <FontIcon FontSize="18" Glyph="&#xE100;" />
                            </Button>
                            <Button
                                AutomationProperties.Name="Forward 10 seconds"
                                Click="Forward10_Click"
                                Style="{StaticResource PlayerIconButtonStyle}"
                                ToolTipService.ToolTip="Forward 10 seconds (Right arrow)">
                                <FontIcon FontSize="18" Glyph="&#xE101;" />
                            </Button>
                            <Button
                                x:Name="VolumeButton"
                                AutomationProperties.Name="Mute"
                                Click="Mute_Click"
                                Style="{StaticResource PlayerIconButtonStyle}"
                                ToolTipService.ToolTip="Mute (M)">
                                <FontIcon x:Name="VolumeIcon" FontSize="18" Glyph="&#xE767;" />
                            </Button>
                            <Slider
                                x:Name="VolumeSlider"
                                Width="90"
                                Margin="2,0,8,0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Volume"
                                Maximum="100"
                                Minimum="0"
                                Value="80"
                                ValueChanged="VolumeSlider_ValueChanged" />
                        </StackPanel>

                        <StackPanel
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                            <TextBlock
                                x:Name="TimeText"
                                MinWidth="96"
                                VerticalAlignment="Center"
                                FontSize="12"
                                TextAlignment="Right"
                                Foreground="{ThemeResource PlayerSecondaryForegroundBrush}"
                                Text="0:00 / 0:00" />
                            <Button
                                x:Name="AudioButton"
                                AutomationProperties.Name="Audio track"
                                Style="{StaticResource PlayerTextButtonStyle}"
                                ToolTipService.ToolTip="Audio track">
                                <Button.Flyout>
                                    <MenuFlyout x:Name="AudioMenu" Opened="AudioMenu_Opened">
                                        <MenuFlyoutItem IsEnabled="False" Text="Loading…" />
                                    </MenuFlyout>
                                </Button.Flyout>
                                <Grid>
                                    <TextBlock Text="Audio" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Ellipse x:Name="AudioMultiDot" Width="5" Height="5" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="{ThemeResource BrandPrimaryBrush}" />
                                </Grid>
                            </Button>
                            <Button
                                x:Name="SubtitlesButton"
                                AutomationProperties.Name="Subtitles"
                                Style="{StaticResource PlayerIconButtonStyle}"
                                ToolTipService.ToolTip="Subtitles">
                                <Button.Flyout>
                                    <Flyout x:Name="SubtitlesFlyout" Opened="SubtitlesFlyout_Opened" Closed="SubtitlesFlyout_Closed" Placement="TopEdgeAlignedRight">
                                        <Border Width="360" Padding="14" Background="{ThemeResource PlayerPanelBackgroundBrush}" CornerRadius="12" RequestedTheme="Dark">
                                            <StackPanel Spacing="8">
                                                <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource PlayerForegroundBrush}" Text="Subtitles" />
                                                <TextBlock x:Name="SubtitleCurrentText" FontSize="11" Foreground="{ThemeResource PlayerSecondaryForegroundBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                                                <StackPanel x:Name="SubtitleStatusPanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                                                    <ProgressRing x:Name="SubtitleLoadingRing" Width="14" Height="14" VerticalAlignment="Center" IsActive="False" Visibility="Collapsed" />
                                                    <TextBlock x:Name="SubtitleStatusText" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource PlayerSecondaryForegroundBrush}" TextWrapping="Wrap" />
                                                </StackPanel>

                                                <Grid>
                                                    <Grid x:Name="SubtitleLanguageView">
                                                        <ListView x:Name="SubtitleLanguageList" MaxHeight="280" IsItemClickEnabled="True" ItemClick="SubtitleLanguageList_ItemClick" ItemContainerStyle="{StaticResource SubtitleListItemStyle}" ItemTemplate="{StaticResource SubtitleLanguageTemplate}" ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionMode="None" />
                                                    </Grid>

                                                    <Grid x:Name="SubtitleVersionView" Visibility="Collapsed">
                                                        <StackPanel Spacing="8">
                                                            <Grid ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Button x:Name="SubtitleVersionBackButton" Width="36" Height="36" AutomationProperties.Name="Back to subtitle languages" Click="SubtitleVersionBack_Click" Style="{StaticResource PlayerIconButtonStyle}" ToolTipService.ToolTip="Back to languages">
                                                                    <FontIcon FontSize="14" Glyph="&#xE72B;" />
                                                                </Button>
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <TextBlock x:Name="SubtitleVersionTitle" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource PlayerForegroundBrush}" TextWrapping="Wrap" />
                                                                    <TextBlock x:Name="SubtitleVersionHint" FontSize="11" Foreground="{ThemeResource PlayerSecondaryForegroundBrush}" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </Grid>
                                                            <ListView x:Name="SubtitleVersionList" MaxHeight="260" ItemContainerStyle="{StaticResource SubtitleListItemStyle}" ItemTemplate="{StaticResource SubtitleVersionTemplate}" ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionChanged="SubtitleVersionList_SelectionChanged" SelectionMode="Single" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>

                                                <!--  Subtitle timing: only relevant once a track is on  -->
                                                <Border x:Name="SubtitleTimingPanel" Padding="12,10" Background="{ThemeResource PlayerPanelBackgroundBrush}" BorderBrush="{ThemeResource PlayerPanelBorderBrush}" BorderThickness="1" CornerRadius="10" Visibility="Collapsed">
                                                    <StackPanel Spacing="8">
                                                        <Grid>
                                                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource PlayerForegroundBrush}" Text="Subtitle timing" />
                                                            <TextBlock HorizontalAlignment="Right" FontSize="10" Foreground="{ThemeResource PlayerTertiaryForegroundBrush}" Text="[ and ] while watching" />
                                                        </Grid>
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <RepeatButton x:Name="SubtitleEarlierButton" AutomationProperties.AutomationId="SubtitleEarlierButton" AutomationProperties.Name="Show subtitles earlier" Click="SubtitleEarlier_Click" Style="{StaticResource SubtitleTimingButtonStyle}" ToolTipService.ToolTip="Show subtitles earlier ([)">
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <FontIcon FontSize="12" Glyph="&#xE738;" />
                                                                    <TextBlock Text="Earlier" />
                                                                </StackPanel>
                                                            </RepeatButton>
                                                            <TextBlock x:Name="SubtitleTimingValue" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource PlayerForegroundBrush}" AutomationProperties.AutomationId="SubtitleTimingValue" Text="0.0 s" />
                                                            <RepeatButton x:Name="SubtitleLaterButton" Grid.Column="2" AutomationProperties.AutomationId="SubtitleLaterButton" AutomationProperties.Name="Show subtitles later" Click="SubtitleLater_Click" Style="{StaticResource SubtitleTimingButtonStyle}" ToolTipService.ToolTip="Show subtitles later (])">
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <TextBlock Text="Later" />
                                                                    <FontIcon FontSize="12" Glyph="&#xE710;" />
                                                                </StackPanel>
                                                            </RepeatButton>
                                                        </Grid>
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock x:Name="SubtitleTimingHint" VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource PlayerSecondaryForegroundBrush}" Text="Subtitles are in sync" TextWrapping="Wrap" />
                                                            <HyperlinkButton x:Name="SubtitleResetButton" Grid.Column="1" Padding="6,0" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.AutomationId="SubtitleResetButton" AutomationProperties.Name="Reset subtitle timing" Click="SubtitleReset_Click" Content="Reset" FontSize="11" MinHeight="0" Visibility="Collapsed" />
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </Flyout>
                                </Button.Flyout>
                                <Grid>
                                    <TextBlock Text="CC" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Ellipse x:Name="SubtitleActiveDot" Width="5" Height="5" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="{ThemeResource BrandPrimaryBrush}" />
                                </Grid>
                            </Button>
                            <Button
                                x:Name="SpeedButton"
                                AutomationProperties.Name="Playback speed"
                                Content="1×"
                                Style="{StaticResource PlayerTextButtonStyle}"
                                ToolTipService.ToolTip="Playback speed">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Click="Speed_Click" Tag="0.5" Text="0.5×" />
                                        <MenuFlyoutItem Click="Speed_Click" Tag="0.75" Text="0.75×" />
                                        <MenuFlyoutItem Click="Speed_Click" Tag="1" Text="1×" />
                                        <MenuFlyoutItem Click="Speed_Click" Tag="1.25" Text="1.25×" />
                                        <MenuFlyoutItem Click="Speed_Click" Tag="1.5" Text="1.5×" />
                                        <MenuFlyoutItem Click="Speed_Click" Tag="2" Text="2×" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <Button
                                x:Name="FullScreenButton"
                                AutomationProperties.Name="Full screen"
                                Click="FullScreen_Click"
                                Style="{StaticResource PlayerIconButtonStyle}"
                                ToolTipService.ToolTip="Full screen (F)">
                                <FontIcon x:Name="FullScreenIcon" FontSize="18" Glyph="&#xE740;" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>

        <!--  Subtitle timing toast: visible without the chrome, never hit-testable  -->
        <Border
            x:Name="SubtitleHudPanel"
            Margin="0,0,0,112"
            Padding="14,8"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Background="{ThemeResource PlayerPanelBackgroundBrush}"
            BorderBrush="{ThemeResource PlayerPanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource BrandPrimaryBrush}" Text="CC" />
                <TextBlock x:Name="SubtitleHudText" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource PlayerForegroundBrush}" AutomationProperties.LiveSetting="Polite" Text="Subtitle timing" />
            </StackPanel>
        </Border>

        <!--  Resume hint, kept outside the chrome so it survives auto-hide  -->
        <Border
            x:Name="ResumePanel"
            Margin="0,84,26,0"
            Padding="12,6,6,6"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Background="{ThemeResource PlayerPanelBackgroundBrush}"
            BorderBrush="{ThemeResource PlayerPanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon
                    FontSize="12"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource PlayerSecondaryForegroundBrush}"
                    Glyph="&#xE81C;" />
                <TextBlock
                    x:Name="ResumeText"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource PlayerForegroundBrush}"
                    Text="Resuming…" />
                <HyperlinkButton
                    x:Name="StartOverButton"
                    Padding="6,2"
                    AutomationProperties.Name="Start over from the beginning"
                    Click="StartOver_Click"
                    Content="Start over"
                    FontSize="12"
                    MinHeight="0"
                    ToolTipService.ToolTip="Start from the beginning" />
            </StackPanel>
        </Border>

        <!--  Up next card, shown shortly before the episode ends  -->
        <Border
            x:Name="UpNextPanel"
            Width="370"
            Margin="0,0,26,104"
            Padding="12"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="{ThemeResource PlayerPanelBackgroundBrush}"
            BorderBrush="{ThemeResource PlayerPanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Visibility="Collapsed">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="112"
                    Height="63"
                    VerticalAlignment="Center"
                    Background="{ThemeResource PlayerBadgeBackgroundBrush}"
                    CornerRadius="6">
                    <Grid>
                        <FontIcon
                            AutomationProperties.AccessibilityView="Raw"
                            FontSize="18"
                            Foreground="{ThemeResource PlayerTertiaryForegroundBrush}"
                            Glyph="&#xE714;"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                        <Image
                            AutomationProperties.AccessibilityView="Raw"
                            Source="{x:Bind ViewModel.NextEpisodeImage}"
                            Stretch="UniformToFill" />
                    </Grid>
                </Border>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="3">
                    <TextBlock
                        CharacterSpacing="110"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource PlayerSecondaryForegroundBrush}"
                        Text="UP NEXT" />
                    <TextBlock
                        MaxLines="2"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource PlayerForegroundBrush}"
                        Text="{x:Bind ViewModel.NextEpisodeLine}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="2"
                    VerticalAlignment="Center">
                    <Button
                        Padding="12,5"
                        AutomationProperties.Name="Play next episode"
                        Click="PlayNext_Click"
                        Content="Play next"
                        FontSize="12"
                        MinHeight="0"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="Play the next episode now" />
                    <Button
                        Width="30"
                        Height="30"
                        AutomationProperties.Name="Don't play next episode"
                        Click="DismissUpNext_Click"
                        Style="{StaticResource PlayerIconButtonStyle}"
                        ToolTipService.ToolTip="Don't play next">
                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--  Source discovery / startup  -->
        <Grid x:Name="LoadingOverlay" Background="{ThemeResource PlayerSurfaceBrush}">
            <Border Opacity="0.45">
                <Border.Background>
                    <ImageBrush ImageSource="{x:Bind ViewModel.BackdropImage}" Stretch="UniformToFill" />
                </Border.Background>
            </Border>
            <Border Background="{ThemeResource PlayerOverlayScrimBrush}" />

            <Button
                AutomationProperties.Name="Back"
                Click="Back_Click"
                Margin="24,14,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Style="{StaticResource PlayerIconButtonStyle}"
                ToolTipService.ToolTip="Back">
                <FontIcon FontSize="18" Glyph="&#xE72B;" />
            </Button>

            <StackPanel
                MaxWidth="620"
                Margin="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
                <Image
                    Width="56"
                    Height="56"
                    HorizontalAlignment="Center"
                    AutomationProperties.AccessibilityView="Raw"
                    Source="ms-appx:///Assets/BrandMark.png" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="24"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource PlayerForegroundBrush}"
                    Text="{x:Bind ViewModel.Title}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="13"
                    Foreground="{ThemeResource PlayerSecondaryForegroundBrush}"
                    Text="{x:Bind ViewModel.Subtitle}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <ProgressRing
                    Width="26"
                    Height="26"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Center"
                    IsActive="True" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource PlayerSecondaryForegroundBrush}"
                    Text="{x:Bind ViewModel.StatusText}" />
            </StackPanel>
        </Grid>

        <!--  Source picker  -->
        <Grid
            x:Name="SourceScrim"
            Background="{ThemeResource PlayerOverlayScrimBrush}"
            Tapped="SourceScrim_Tapped"
            Visibility="Collapsed" />

        <Grid
            x:Name="SourcePanel"
            Width="440"
            HorizontalAlignment="Right"
            Visibility="Collapsed">
            <Border
                Background="{ThemeResource PlayerPanelBackgroundBrush}"
                BorderBrush="{ThemeResource PlayerPanelBorderBrush}"
                BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="24,20,16,12">
                        <StackPanel>
                            <TextBlock
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource PlayerForegroundBrush}"
                                Text="Sources" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource PlayerSecondaryForegroundBrush}"
                                Text="{x:Bind ViewModel.SourcesLabel}" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{ThemeResource PlayerTertiaryForegroundBrush}"
                                Text="Choose a source to start" />
                        </StackPanel>
                        <Button
                            HorizontalAlignment="Right"
                            AutomationProperties.Name="Close sources"
                            Click="CloseSources_Click"
                            Style="{StaticResource PlayerIconButtonStyle}">
                            <FontIcon FontSize="16" Glyph="&#xE711;" />
                        </Button>
                    </Grid>

                    <ListView
                        x:Name="SourceList"
                        Grid.Row="1"
                        Margin="12,0,12,18"
                        IsItemClickEnabled="True"
                        ItemClick="SourceList_ItemClick"
                        ItemContainerStyle="{StaticResource PlayerSourceItemStyle}"
                        ItemTemplateSelector="{StaticResource SourceItemTemplateSelector}"
                        ItemsSource="{x:Bind ViewModel.SourceItems}"
                        SelectionMode="None"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                </Grid>
            </Border>
        </Grid>

        <!--  Playback error  -->
        <Grid
            x:Name="ErrorPanel"
            Background="{ThemeResource PlayerOverlayScrimBrush}"
            Visibility="Collapsed">
            <Border
                MaxWidth="560"
                Padding="26"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource PlayerPanelBackgroundBrush}"
                BorderBrush="{ThemeResource PlayerPanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel Spacing="12">
                    <FontIcon
                        FontSize="28"
                        Foreground="{ThemeResource PlayerForegroundBrush}"
                        Glyph="&#xE7BA;" />
                    <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource PlayerForegroundBrush}"
                        Text="Couldn't play this source" />
                    <TextBlock
                        x:Name="ErrorText"
                        FontSize="13"
                        Foreground="{ThemeResource PlayerSecondaryForegroundBrush}"
                        TextWrapping="Wrap" />
                    <StackPanel
                        Margin="0,6,0,0"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            x:Name="RetryButton"
                            Click="Retry_Click"
                            Content="Retry"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button
                            x:Name="NextSourceButton"
                            Click="NextSource_Click"
                            Content="Next source" />
                        <Button Click="Back_Click" Content="Back" />
                        <Button
                            AutomationProperties.Name="Manage addons"
                            Click="ManageAddons_Click"
                            Content="Manage addons" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
