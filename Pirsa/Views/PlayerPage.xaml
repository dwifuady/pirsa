<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Pirsa.Views.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:Pirsa.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Pirsa.ViewModels"
    x:DefaultBindMode="OneWay"
    Background="{ThemeResource PlayerSurfaceBrush}"
    KeyboardAcceleratorPlacementMode="Hidden"
    NavigationCacheMode="Disabled"
    RequestedTheme="Dark"
    mc:Ignorable="d">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F" Invoked="FullscreenAccelerator_Invoked" />
        <KeyboardAccelerator Key="M" Invoked="MuteAccelerator_Invoked" />
        <KeyboardAccelerator Key="E" Invoked="EpisodesAccelerator_Invoked" />
        <KeyboardAccelerator Key="I" Invoked="InfoAccelerator_Invoked" />
        <KeyboardAccelerator Key="Escape" Invoked="EscapeAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Page.Resources>
        <!--
            Slow breathing pulse for the title artwork on the startup overlay.
            It reassures the eye that the app is still working without the
            spinner being the only thing moving. The target is bound in code:
            a Storyboard inside a ResourceDictionary cannot resolve the page's
            namescope by TargetName.
        -->
        <Storyboard
            x:Key="LoadingBreathStoryboard"
            AutoReverse="True"
            RepeatBehavior="Forever">
            <DoubleAnimation
                Storyboard.TargetProperty="Opacity"
                Duration="0:0:2"
                From="1"
                To="0.45">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleX)"
                Duration="0:0:2"
                From="1"
                To="1.015">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)"
                Duration="0:0:2"
                From="1"
                To="1.015">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Style x:Key="SubtitleListItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="EpisodesFlyoutPresenterStyle" TargetType="FlyoutPresenter">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MaxHeight" Value="620" />
        </Style>
        <Style x:Key="SourcesFlyoutPresenterStyle" TargetType="FlyoutPresenter">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MaxHeight" Value="552" />
        </Style>

        <!--
            Tints a transport-bar icon for its "on" state (subtitles showing, a
            second audio track available). Applied from code so the glyph keeps
            its normal foreground otherwise; the ThemeResource resolves against
            the page's dark theme either way.
        -->
        <Style x:Key="PlayerIconActiveStyle" TargetType="FontIcon">
            <Setter Property="Foreground" Value="{ThemeResource BrandPrimaryBrush}" />
        </Style>
        <Style x:Key="SubtitleTimingButtonStyle" TargetType="RepeatButton">
            <Setter Property="Width" Value="104" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="{ThemeResource PlayerControlBackgroundBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource PlayerForegroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Delay" Value="400" />
            <Setter Property="Interval" Value="80" />
        </Style>

        <!--  A row that opens lyric sync; it explains itself without a tooltip.  -->
        <Style x:Key="SubtitleSyncEntryStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Background" Value="{ThemeResource PlayerControlBackgroundBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource PlayerForegroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="0" />
        </Style>

        <!--  A clickable lyric row: quiet by default, bright on hover.  -->
        <Style x:Key="LyricLineButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <!--  Lyric rows are built in code; the styles keep their colours theme-aware.  -->
        <Style x:Key="LyricCurrentTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource PlayerForegroundBrush}" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="MaxLines" Value="3" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="LyricLineTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource PlayerForegroundBrush}" />
            <Setter Property="MaxLines" Value="2" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="LyricAlignHintStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource BrandPrimaryBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--
            The lyric view fades out of the picture rather than sitting in a
            card, so the scene and the actors stay visible behind the text.
        -->
        <LinearGradientBrush x:Key="LyricSyncScrimBrush" StartPoint="0.5,1" EndPoint="0.5,0">
            <GradientStop Offset="0" Color="#FA000000" />
            <GradientStop Offset="0.55" Color="#E0000000" />
            <GradientStop Offset="1" Color="#00000000" />
        </LinearGradientBrush>
        <DataTemplate x:Key="SubtitleLanguageTemplate" x:DataType="vm:SubtitleLanguageChoice">
            <StackPanel Spacing="1">
                <TextBlock
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource PlayerForegroundBrush}"
                    Text="{x:Bind LanguageName}" />
                <TextBlock
                    FontSize="11"
                    Foreground="{ThemeResource PlayerSecondaryForegroundBrush}"
                    Text="{x:Bind Detail}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="SubtitleVersionTemplate" x:DataType="vm:SubtitleVersionChoice">
            <StackPanel Spacing="1">
                <TextBlock
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource PlayerForegroundBrush}"
                    Text="{x:Bind Label}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    MaxLines="2"
                    FontSize="11"
                    Foreground="{ThemeResource PlayerSecondaryForegroundBrush}"
                    Text="{x:Bind Detail}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>


        <!--
            A source row in the picker. Compact single-column list: quality badge,
            release/provider, then size, format and addon on one line. The playing
            source is marked with an accent check and a subtle fill.
        -->
        <DataTemplate x:Key="SourceRowTemplate" x:DataType="vm:PlaybackSource">
            <Grid>
                <Border
                    Background="{ThemeResource PlayerBadgeBackgroundBrush}"
                    CornerRadius="6"
                    Opacity="0.45"
                    Visibility="{x:Bind helpers:XamlHelpers.Visible(IsCurrent)}" />

                <Grid Padding="2" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Width="42"
                        Height="24"
                        VerticalAlignment="Center"
                        Background="{ThemeResource PlayerBadgeBackgroundBrush}"
                        CornerRadius="5">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource PlayerBadgeForegroundBrush}"
                            Text="{x:Bind QualityLabel}" />
                    </Border>

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="1">
                        <TextBlock
                            MaxLines="1"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource PlayerForegroundBrush}"
                            Text="{x:Bind PrimaryLine}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            MaxLines="1"
                            FontSize="11"
                            Foreground="{ThemeResource PlayerSecondaryForegroundBrush}"
                            Text="{x:Bind SubtitleLine}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            MaxLines="1"
                            FontSize="10"
                            Foreground="{ThemeResource PlayerTertiaryForegroundBrush}"
                            Text="{x:Bind DetailsLine}"
                            TextTrimming="CharacterEllipsis"
                            Visibility="{x:Bind helpers:XamlHelpers.Visible(HasDetails)}" />
                    </StackPanel>

                    <Grid Grid.Column="2" Width="16">
                        <!--
                            TextBlock rather than FontIcon: a TextBlock has an
                            automation peer, so a screen reader still hears that
                            this is the source that is playing.
                        -->
                        <TextBlock
                            AutomationProperties.Name="Playing"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="12"
                            Foreground="{ThemeResource BrandPrimaryBrush}"
                            Text="&#xE73E;"
                            Visibility="{x:Bind helpers:XamlHelpers.Visible(IsCurrent)}" />
                    </Grid>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="EpisodeRowTemplate" x:DataType="vm:PlayerEpisode">
            <Grid Padding="2" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="112"
                    Height="63"
                    VerticalAlignment="Center"
                    Background="{ThemeResource PlayerBadgeBackgroundBrush}"
                    CornerRadius="6">
                    <Grid>
                        <FontIcon
                            AutomationProperties.AccessibilityView="Raw"
                            FontSize="18"
                            Foreground="{ThemeResource PlayerTertiaryForegroundBrush}"
                            Glyph="&#xE714;"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                        <Image
                            AutomationProperties.AccessibilityView="Raw"
                            Source="{x:Bind ThumbnailImage}"
                            Stretch="UniformToFill" />
                        <Border
                            Margin="5"
                            Padding="5,1"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="{ThemeResource OverlayChipBackgroundBrush}"
                            CornerRadius="4">
                            <TextBlock
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource OverlayChipForegroundBrush}"
                                Text="{x:Bind EpisodeTag}" />
                        </Border>
                        <ProgressBar
                            Height="3"
                            Margin="5,0,5,5"
                            VerticalAlignment="Bottom"
                            AutomationProperties.Name="Watch progress"
                            Background="{ThemeResource OverlayChipBackgroundBrush}"
                            Foreground="{ThemeResource BrandPrimaryBrush}"
                            Maximum="1"
                            Value="{x:Bind WatchProgress}"
                            Visibility="{x:Bind helpers:XamlHelpers.Visible(HasWatchProgress)}" />
                    </Grid>
                </Border>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="3">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            MaxLines="1"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource PlayerForegroundBrush}"
                            Text="{x:Bind Title}"
                            TextTrimming="CharacterEllipsis" />
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="6">
                            <Border
                                Padding="6,2"
                                Background="{ThemeResource BrandSubtleBrush}"
                                CornerRadius="4"
                                Visibility="{x:Bind helpers:XamlHelpers.Visible(IsCurrent)}">
                                <TextBlock
                                    FontSize="10"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource BrandPrimaryBrush}"
                                    Text="Now playing" />
                            </Border>
                            <FontIcon
                                FontSize="12"
                                Foreground="{ThemeResource BrandPrimaryBrush}"
                                Glyph="&#xE73E;"
                                Visibility="{x:Bind helpers:XamlHelpers.Visible(IsWatched)}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock
                        MaxLines="2"
                        FontSize="11"
                        Foreground="{ThemeResource PlayerSecondaryForegroundBrush}"
                        Text="{x:Bind DescriptionText}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind helpers:XamlHelpers.VisibleIfText(DescriptionText)}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="Root" Background="{ThemeResource PlayerSurfaceBrush}">
        <!--  The selected playback engine adds its own surface here.  -->
        <Grid
            x:Name="VideoHost"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch" />

        <!--  Click surface for play/pause and waking the chrome  -->
        <Grid
            x:Name="InputLayer"
            Background="Transparent"
            PointerMoved="InputLayer_PointerMoved"
            Tapped="InputLayer_Tapped" />

        <!--
            Artwork for the moment before a source is chosen. The video surface is
            blank until something plays, and a picker hanging over black looks like
            an orphaned menu, so the poster stays up behind the chrome instead.
        -->
        <Grid x:Name="PickerBackdrop" Visibility="Collapsed">
            <Border Opacity="{ThemeResource HeroImageOpacity}">
                <Border.Background>
                    <ImageBrush ImageSource="{x:Bind ViewModel.LoadingArtworkImage, Mode=OneWay}" Stretch="UniformToFill" />
                </Border.Background>
            </Border>
            <Border Background="{ThemeResource PlayerLoadingScrimBrush}" />
        </Grid>

        <!--  Playback chrome  -->
        <Grid
            x:Name="Chrome"
            IsHitTestVisible="False"
            Opacity="0">
            <Border
                Height="160"
                VerticalAlignment="Top"
                Background="{ThemeResource PlayerTopScrimBrush}"
                IsHitTestVisible="False" />
            <Border
                Height="280"
                VerticalAlignment="Bottom"
                Background="{ThemeResource PlayerBottomScrimBrush}"
                IsHitTestVisible="False" />

            <!--
                Pause details: a borderless block of title, year, rating, genres
                and plot over a soft corner shade. The radial scrim is dense
                under the text and gone by its far edge, so it reads as light on
                the frame rather than a card, yet stays legible on a bright
                scene. It sits clear of the transport bar and subtitles, and
                stops short of the centred play button at the smallest window
                size. It is never hit-testable, so the click-to-play layer keeps
                working underneath. "I" shows it while playing too.
            -->
            <Grid
                x:Name="InfoPanel"
                Width="780"
                Height="545"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="{ThemeResource PlayerInfoScrimBrush}"
                IsHitTestVisible="False"
                Opacity="0"
                Visibility="Collapsed">
                <Grid.RenderTransform>
                    <CompositeTransform TranslateY="12" />
                </Grid.RenderTransform>

                <StackPanel
                    Width="380"
                    Margin="28,84,0,0"
                    Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border
                            Padding="8,3"
                            VerticalAlignment="Center"
                            Background="{ThemeResource PlayerBadgeBackgroundBrush}"
                            CornerRadius="4">
                            <TextBlock
                                CharacterSpacing="110"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource PlayerBadgeForegroundBrush}"
                                Text="{x:Bind ViewModel.InfoTypeLabel}" />
                        </Border>

                        <Border
                            Padding="8,3"
                            VerticalAlignment="Center"
                            Background="{ThemeResource PlayerBadgeBackgroundBrush}"
                            CornerRadius="4"
                            Visibility="{x:Bind helpers:XamlHelpers.Visible(ViewModel.HasInfoRating)}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon
                                    FontSize="10"
                                    Foreground="{ThemeResource BrandPrimaryBrush}"
                                    Glyph="&#xE735;" />
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource PlayerForegroundBrush}"
                                    Text="{x:Bind ViewModel.InfoRatingText}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <TextBlock
                        MaxLines="2"
                        CharacterSpacing="-10"
                        FontFamily="Segoe UI Variable Display"
                        FontSize="26"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource PlayerForegroundBrush}"
                        LineHeight="34"
                        Text="{x:Bind ViewModel.InfoTitle}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />

                    <TextBlock
                        MaxLines="1"
                        FontSize="11"
                        Foreground="{ThemeResource PlayerSecondaryForegroundBrush}"
                        Text="{x:Bind ViewModel.InfoMetaLine}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind helpers:XamlHelpers.Visible(ViewModel.HasInfoMetaLine)}" />

                    <TextBlock
                        MaxLines="1"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource PlayerSecondaryForegroundBrush}"
                        Text="{x:Bind ViewModel.InfoEpisodeLine}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind helpers:XamlHelpers.Visible(ViewModel.HasInfoEpisodeLine)}" />

                    <TextBlock
                        MaxWidth="380"
                        MaxLines="4"
                        FontSize="13"
                        Foreground="{ThemeResource PlayerSecondaryForegroundBrush}"
                        LineHeight="19"
                        Text="{x:Bind ViewModel.InfoPlot}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind helpers:XamlHelpers.Visible(ViewModel.HasInfoPlot)}" />
                </StackPanel>
            </Grid>

            <Grid
                Height="56"
                Margin="24,14,24,0"
                VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="OverlayBackButton"
                    AutomationProperties.Name="Back"
                    Click="Back_Click"
                    Style="{StaticResource PlayerIconButtonStyle}"
                    ToolTipService.ToolTip="Back"
                    Visibility="Collapsed">
                    <FontIcon FontSize="18" Glyph="&#xE72B;" />
                </Button>

                <StackPanel
                    x:Name="NowPlayingTitle"
                    Grid.Column="1"
                    Margin="12,0,20,0"
                    VerticalAlignment="Center">
                    <TextBlock
                        MaxLines="1"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource PlayerForegroundBrush}"
                        Text="{x:Bind ViewModel.Title}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        MaxLines="1"
                        FontSize="12"
                        Foreground="{ThemeResource PlayerSecondaryForegroundBrush}"
                        Text="{x:Bind ViewModel.Subtitle}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="EpisodesButton"
                        AutomationProperties.Name="Episodes"
                        Click="OpenEpisodes_Click"
                        Style="{StaticResource PlayerTextButtonStyle}"
                        ToolTipService.ToolTip="Choose an episode (E)"
                        Visibility="{x:Bind helpers:XamlHelpers.Visible(ViewModel.CanBrowseEpisodes)}">
                        <Button.Flyout>
                            <Flyout
                                x:Name="EpisodesFlyout"
                                Closed="EpisodesFlyout_Closed"
                                FlyoutPresenterStyle="{StaticResource EpisodesFlyoutPresenterStyle}"
                                Opened="EpisodesFlyout_Opened"
                                Placement="BottomEdgeAlignedRight">
                                <Grid
                                    Width="452"
                                    MaxHeight="600"
                                    RequestedTheme="Dark">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Grid Margin="18,14,10,8" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock
                                                FontSize="20"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource PlayerForegroundBrush}"
                                                Text="Episodes" />
                                            <TextBlock
                                                MaxLines="1"
                                                FontSize="12"
                                                Foreground="{ThemeResource PlayerSecondaryForegroundBrush}"
                                                Text="{x:Bind ViewModel.Title}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            AutomationProperties.Name="Close episodes"
                                            Click="CloseEpisodes_Click"
                                            Style="{StaticResource PlayerIconButtonStyle}"
                                            ToolTipService.ToolTip="Close">
                                            <FontIcon FontSize="14" Glyph="&#xE711;" />
                                        </Button>
                                    </Grid>

                                    <StackPanel
                                        Grid.Row="1"
                                        Margin="18,0,18,10"
                                        Orientation="Horizontal"
                                        Spacing="10">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{ThemeResource PlayerSecondaryForegroundBrush}"
                                            Text="Season" />
                                        <ComboBox
                                            MinWidth="160"
                                            AutomationProperties.Name="Season"
                                            DisplayMemberPath="DisplayLabel"
                                            ItemsSource="{x:Bind ViewModel.Seasons}"
                                            SelectedItem="{x:Bind ViewModel.SelectedSeason, Mode=TwoWay}" />
                                    </StackPanel>

                                    <ListView
                                        x:Name="EpisodeList"
                                        Grid.Row="2"
                                        Margin="8,0,8,8"
                                        IsItemClickEnabled="True"
                                        ItemClick="EpisodeList_ItemClick"
                                        ItemContainerStyle="{StaticResource PlayerSourceItemStyle}"
                                        ItemTemplate="{StaticResource EpisodeRowTemplate}"
                                        ItemsSource="{x:Bind ViewModel.Episodes}"
                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                        SelectionMode="None" />
                                </Grid>
                            </Flyout>
                        </Button.Flyout>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="13" Glyph="&#xE8FD;" />
                            <TextBlock Text="Episodes" />
                        </StackPanel>
                    </Button>

                    <Button
                        x:Name="InfoButton"
                        AutomationProperties.Name="Title details"
                        Click="Info_Click"
                        Style="{StaticResource PlayerTextButtonStyle}"
                        ToolTipService.ToolTip="Title details (I)">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="13" Glyph="&#xE946;" />
                            <TextBlock Text="Info" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
                <Button
                    x:Name="CenterPlayButton"
                    AutomationProperties.Name="Play"
                    Click="PlayPause_Click"
                    Style="{StaticResource PlayerCenterButtonStyle}"
                    ToolTipService.ToolTip="Play / pause (Space)"
                    Visibility="Collapsed">
                    <FontIcon x:Name="CenterPlayIcon" FontSize="34" Glyph="&#xE768;" />
                </Button>
                <TextBlock
                    x:Name="EndedText"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource PlayerSecondaryForegroundBrush}"
                    Text="Playback finished"
                    Visibility="Collapsed" />
            </StackPanel>

            <StackPanel
                x:Name="BufferPanel"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="Collapsed">
                <ProgressRing
                    x:Name="BufferRing"
                    Width="44"
                    Height="44"
                    IsActive="False" />
                <TextBlock
                    x:Name="BufferText"
                    Foreground="{ThemeResource PlayerSecondaryForegroundBrush}"
                    Text="Buffering…" />
            </StackPanel>

            <Grid
                Margin="32,0,32,20"
                VerticalAlignment="Bottom">
                <StackPanel>
                    <Slider
                        x:Name="SeekSlider"
                        AutomationProperties.Name="Seek"
                        IsThumbToolTipEnabled="False"
                        Maximum="1"
                        Minimum="0"
                        ValueChanged="SeekSlider_ValueChanged" />

                    <Grid Height="48" Margin="0,-6,0,0">
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="2"
                            VerticalAlignment="Center">
                            <Button
                                x:Name="PlayPauseButton"
                                AutomationProperties.Name="Play"
                                Click="PlayPause_Click"
                                Style="{StaticResource PlayerIconButtonStyle}"
                                ToolTipService.ToolTip="Play / pause (Space)">
                                <FontIcon x:Name="PlayPauseIcon" FontSize="22" Glyph="&#xE768;" />
                            </Button>
                            <Button
                                AutomationProperties.Name="Back 10 seconds"
                                Click="Back10_Click"
                                Style="{StaticResource PlayerIconButtonStyle}"
                                ToolTipService.ToolTip="Back 10 seconds (Left arrow)">
                                <FontIcon FontSize="18" Glyph="&#xE100;" />
                            </Button>
                            <Button
                                AutomationProperties.Name="Forward 10 seconds"
                                Click="Forward10_Click"
                                Style="{StaticResource PlayerIconButtonStyle}"
                                ToolTipService.ToolTip="Forward 10 seconds (Right arrow)">
                                <FontIcon FontSize="18" Glyph="&#xE101;" />
                            </Button>
                            <Button
                                x:Name="VolumeButton"
                                AutomationProperties.Name="Mute"
                                Click="Mute_Click"
                                Style="{StaticResource PlayerIconButtonStyle}"
                                ToolTipService.ToolTip="Mute (M)">
                                <FontIcon x:Name="VolumeIcon" FontSize="18" Glyph="&#xE767;" />
                            </Button>
                            <Slider
                                x:Name="VolumeSlider"
                                Width="90"
                                Margin="2,0,8,0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Volume"
                                Maximum="100"
                                Minimum="0"
                                ValueChanged="VolumeSlider_ValueChanged" />
                        </StackPanel>

                        <StackPanel
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                            <TextBlock
                                x:Name="TimeText"
                                MinWidth="96"
                                VerticalAlignment="Center"
                                FontSize="12"
                                TextAlignment="Right"
                                Foreground="{ThemeResource PlayerSecondaryForegroundBrush}"
                                Text="0:00 / 0:00" />
                            <Button
                                x:Name="SourcesButton"
                                AutomationProperties.Name="Source"
                                Style="{StaticResource PlayerTextButtonStyle}"
                                ToolTipService.ToolTip="Choose a source">
                                <Button.Flyout>
                                    <Flyout
                                        x:Name="SourcesFlyout"
                                        Closed="SourcesFlyout_Closed"
                                        FlyoutPresenterStyle="{StaticResource SourcesFlyoutPresenterStyle}"
                                        Opened="SourcesFlyout_Opened"
                                        Placement="TopEdgeAlignedRight">
                                        <Grid
                                            Width="372"
                                            MaxHeight="540"
                                            RequestedTheme="Dark">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <Border
                                                Padding="16,14,16,10"
                                                BorderBrush="{ThemeResource PlayerPanelBorderBrush}"
                                                BorderThickness="0,0,0,1">
                                                <StackPanel Spacing="2">
                                                    <TextBlock
                                                        FontSize="16"
                                                        FontWeight="SemiBold"
                                                        Foreground="{ThemeResource PlayerForegroundBrush}"
                                                        Text="{x:Bind ViewModel.SourceFlyoutTitle, Mode=OneWay}" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{ThemeResource PlayerSecondaryForegroundBrush}"
                                                        Text="{x:Bind ViewModel.SourceFlyoutDetail, Mode=OneWay}" />
                                                </StackPanel>
                                            </Border>

                                            <!--
                                                One tab per addon, so a long ranked list becomes
                                                a short scroll. Hidden with a single addon,
                                                where "All" would just repeat it.
                                            -->
                                            <ScrollViewer
                                                Grid.Row="1"
                                                Margin="10,4,10,2"
                                                HorizontalScrollBarVisibility="Auto"
                                                HorizontalScrollMode="Enabled"
                                                VerticalScrollBarVisibility="Disabled"
                                                VerticalScrollMode="Disabled"
                                                Visibility="{x:Bind helpers:XamlHelpers.Visible(ViewModel.HasMultipleSourceTabs), Mode=OneWay}">
                                                <SelectorBar
                                                    x:Name="SourceTabBar"
                                                    AutomationProperties.Name="Source addons"
                                                    SelectionChanged="SourceTabBar_SelectionChanged" />
                                            </ScrollViewer>

                                            <ListView
                                                x:Name="SourceList"
                                                Grid.Row="2"
                                                Margin="8,0,8,8"
                                                AutomationProperties.Name="Sources"
                                                IsItemClickEnabled="True"
                                                ItemClick="SourceList_ItemClick"
                                                ItemContainerStyle="{StaticResource PlayerSourceItemStyle}"
                                                ItemTemplate="{StaticResource SourceRowTemplate}"
                                                ItemsSource="{x:Bind ViewModel.VisibleSources}"
                                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                SelectionMode="None" />
                                        </Grid>
                                    </Flyout>
                                </Button.Flyout>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.SourceButtonLabel, Mode=OneWay}" />
                                    <FontIcon
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        Glyph="&#xE70E;" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="AudioButton"
                                AutomationProperties.Name="Audio track"
                                Style="{StaticResource PlayerIconButtonStyle}"
                                ToolTipService.ToolTip="Audio track">
                                <Button.Flyout>
                                    <MenuFlyout x:Name="AudioMenu" Opened="AudioMenu_Opened">
                                        <MenuFlyoutItem IsEnabled="False" Text="Loading…" />
                                    </MenuFlyout>
                                </Button.Flyout>
                                <FontIcon
                                    x:Name="AudioIcon"
                                    FontSize="17"
                                    Glyph="&#xE8D6;" />
                            </Button>
                            <Button
                                x:Name="SubtitlesButton"
                                AutomationProperties.Name="Subtitles"
                                Style="{StaticResource PlayerIconButtonStyle}"
                                ToolTipService.ToolTip="Subtitles">
                                <Button.Flyout>
                                    <Flyout x:Name="SubtitlesFlyout" Opened="SubtitlesFlyout_Opened" Closed="SubtitlesFlyout_Closed" Placement="TopEdgeAlignedRight">
                                        <Border Width="360" Padding="14" Background="{ThemeResource PlayerPanelBackgroundBrush}" CornerRadius="12" RequestedTheme="Dark">
                                            <StackPanel Spacing="8">
                                                <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource PlayerForegroundBrush}" Text="Subtitles" />
                                                <TextBlock x:Name="SubtitleCurrentText" FontSize="11" Foreground="{ThemeResource PlayerSecondaryForegroundBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                                                <StackPanel x:Name="SubtitleStatusPanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                                                    <ProgressRing x:Name="SubtitleLoadingRing" Width="14" Height="14" VerticalAlignment="Center" IsActive="False" Visibility="Collapsed" />
                                                    <TextBlock x:Name="SubtitleStatusText" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource PlayerSecondaryForegroundBrush}" TextWrapping="Wrap" />
                                                </StackPanel>

                                                <Grid>
                                                    <Grid x:Name="SubtitleLanguageView">
                                                        <ListView x:Name="SubtitleLanguageList" MaxHeight="280" IsItemClickEnabled="True" ItemClick="SubtitleLanguageList_ItemClick" ItemContainerStyle="{StaticResource SubtitleListItemStyle}" ItemTemplate="{StaticResource SubtitleLanguageTemplate}" ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionMode="None" />
                                                    </Grid>

                                                    <Grid x:Name="SubtitleVersionView" Visibility="Collapsed">
                                                        <StackPanel Spacing="8">
                                                            <Grid ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Button x:Name="SubtitleVersionBackButton" Width="36" Height="36" AutomationProperties.Name="Back to subtitle languages" Click="SubtitleVersionBack_Click" Style="{StaticResource PlayerIconButtonStyle}" ToolTipService.ToolTip="Back to languages">
                                                                    <FontIcon FontSize="14" Glyph="&#xE72B;" />
                                                                </Button>
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <TextBlock x:Name="SubtitleVersionTitle" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource PlayerForegroundBrush}" TextWrapping="Wrap" />
                                                                    <TextBlock x:Name="SubtitleVersionHint" FontSize="11" Foreground="{ThemeResource PlayerSecondaryForegroundBrush}" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </Grid>
                                                            <ListView x:Name="SubtitleVersionList" MaxHeight="260" ItemContainerStyle="{StaticResource SubtitleListItemStyle}" ItemTemplate="{StaticResource SubtitleVersionTemplate}" ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionChanged="SubtitleVersionList_SelectionChanged" SelectionMode="Single" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>

                                                <!--  Subtitle timing: only relevant once a track is on  -->
                                                <Border x:Name="SubtitleTimingPanel" Padding="12,10" Background="{ThemeResource PlayerPanelBackgroundBrush}" BorderBrush="{ThemeResource PlayerPanelBorderBrush}" BorderThickness="1" CornerRadius="10" Visibility="Collapsed">
                                                    <StackPanel Spacing="8">
                                                        <Grid>
                                                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource PlayerForegroundBrush}" Text="Subtitle timing" />
                                                            <TextBlock HorizontalAlignment="Right" FontSize="10" Foreground="{ThemeResource PlayerTertiaryForegroundBrush}" Text="[ and ] while watching" />
                                                        </Grid>
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <RepeatButton x:Name="SubtitleEarlierButton" AutomationProperties.AutomationId="SubtitleEarlierButton" AutomationProperties.Name="Show subtitles earlier" Click="SubtitleEarlier_Click" Style="{StaticResource SubtitleTimingButtonStyle}" ToolTipService.ToolTip="Show subtitles earlier ([)">
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <FontIcon FontSize="12" Glyph="&#xE738;" />
                                                                    <TextBlock Text="Earlier" />
                                                                </StackPanel>
                                                            </RepeatButton>
                                                            <TextBlock x:Name="SubtitleTimingValue" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource PlayerForegroundBrush}" AutomationProperties.AutomationId="SubtitleTimingValue" Text="0.0 s" />
                                                            <RepeatButton x:Name="SubtitleLaterButton" Grid.Column="2" AutomationProperties.AutomationId="SubtitleLaterButton" AutomationProperties.Name="Show subtitles later" Click="SubtitleLater_Click" Style="{StaticResource SubtitleTimingButtonStyle}" ToolTipService.ToolTip="Show subtitles later (])">
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <TextBlock Text="Later" />
                                                                    <FontIcon FontSize="12" Glyph="&#xE710;" />
                                                                </StackPanel>
                                                            </RepeatButton>
                                                        </Grid>
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock x:Name="SubtitleTimingHint" VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource PlayerSecondaryForegroundBrush}" Text="Subtitles are in sync" TextWrapping="Wrap" />
                                                            <HyperlinkButton x:Name="SubtitleResetButton" Grid.Column="1" Padding="6,0" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.AutomationId="SubtitleResetButton" AutomationProperties.Name="Reset subtitle timing" Click="SubtitleReset_Click" Content="Reset" FontSize="11" MinHeight="0" Visibility="Collapsed" />
                                                        </Grid>

                                                        <!--
                                                            Timing by ear: the lines around the
                                                            playhead appear like lyrics, and
                                                            clicking the one you hear aligns it.
                                                            Hidden for embedded tracks, which
                                                            have no cue file to read.
                                                        -->
                                                        <Button
                                                            x:Name="LyricSyncButton"
                                                            AutomationProperties.AutomationId="LyricSyncButton"
                                                            AutomationProperties.Name="Sync subtitle timing by ear"
                                                            Click="LyricSync_Click"
                                                            Style="{StaticResource SubtitleSyncEntryStyle}"
                                                            Visibility="Collapsed">
                                                            <Grid ColumnSpacing="10">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <FontIcon
                                                                    VerticalAlignment="Center"
                                                                    FontSize="15"
                                                                    Foreground="{ThemeResource BrandPrimaryBrush}"
                                                                    Glyph="&#xE895;" />
                                                                <StackPanel Grid.Column="1" Spacing="1">
                                                                    <TextBlock
                                                                        FontSize="12"
                                                                        FontWeight="SemiBold"
                                                                        Foreground="{ThemeResource PlayerForegroundBrush}"
                                                                        Text="Sync by ear" />
                                                                    <TextBlock
                                                                        FontSize="11"
                                                                        Foreground="{ThemeResource PlayerSecondaryForegroundBrush}"
                                                                        Text="Click the line you hear"
                                                                        TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                                <FontIcon
                                                                    Grid.Column="2"
                                                                    VerticalAlignment="Center"
                                                                    FontSize="10"
                                                                    Foreground="{ThemeResource PlayerTertiaryForegroundBrush}"
                                                                    Glyph="&#xE76C;" />
                                                            </Grid>
                                                        </Button>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </Flyout>
                                </Button.Flyout>
                                <FontIcon
                                    x:Name="SubtitlesIcon"
                                    FontSize="17"
                                    Glyph="&#xE7F0;" />
                            </Button>
                            <Button
                                x:Name="SpeedButton"
                                AutomationProperties.Name="Playback speed"
                                Content="1×"
                                Style="{StaticResource PlayerTextButtonStyle}"
                                ToolTipService.ToolTip="Playback speed">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Click="Speed_Click" Tag="0.5" Text="0.5×" />
                                        <MenuFlyoutItem Click="Speed_Click" Tag="0.75" Text="0.75×" />
                                        <MenuFlyoutItem Click="Speed_Click" Tag="1" Text="1×" />
                                        <MenuFlyoutItem Click="Speed_Click" Tag="1.25" Text="1.25×" />
                                        <MenuFlyoutItem Click="Speed_Click" Tag="1.5" Text="1.5×" />
                                        <MenuFlyoutItem Click="Speed_Click" Tag="2" Text="2×" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <Button
                                x:Name="FullScreenButton"
                                AutomationProperties.Name="Full screen"
                                Click="FullScreen_Click"
                                Style="{StaticResource PlayerIconButtonStyle}"
                                ToolTipService.ToolTip="Full screen (F)">
                                <FontIcon x:Name="FullScreenIcon" FontSize="18" Glyph="&#xE740;" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>

        <!--  Subtitle timing toast: visible without the chrome, never hit-testable  -->
        <Border
            x:Name="SubtitleHudPanel"
            Margin="0,0,0,112"
            Padding="14,8"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Background="{ThemeResource PlayerPanelBackgroundBrush}"
            BorderBrush="{ThemeResource PlayerPanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource BrandPrimaryBrush}" Text="CC" />
                <TextBlock x:Name="SubtitleHudText" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource PlayerForegroundBrush}" AutomationProperties.LiveSetting="Polite" Text="Subtitle timing" />
            </StackPanel>
        </Border>

        <!--  Auto-skip feedback, visible without the chrome, never hit-testable  -->
        <Border
            x:Name="SkipHudPanel"
            Margin="0,0,0,152"
            Padding="14,8"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Background="{ThemeResource PlayerPanelBackgroundBrush}"
            BorderBrush="{ThemeResource PlayerPanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource BrandPrimaryBrush}"
                    Glyph="&#xE893;" />
                <TextBlock
                    x:Name="SkipHudText"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource PlayerForegroundBrush}"
                    Text="Skipped intro" />
            </StackPanel>
        </Border>

        <!--
            Lyric-style subtitle sync. The lines around the playhead sit over the
            bottom of the picture like a lyrics view; clicking a line aligns it
            to the moment it was clicked. The video keeps playing underneath.
        -->
        <Border
            x:Name="LyricSyncPanel"
            Padding="0,44,0,0"
            VerticalAlignment="Bottom"
            Background="{StaticResource LyricSyncScrimBrush}"
            Visibility="Collapsed">
            <Grid
                MaxWidth="880"
                Margin="24,0,24,20"
                HorizontalAlignment="Stretch">
                <StackPanel Spacing="6">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock
                                FontSize="10"
                                FontWeight="SemiBold"
                                CharacterSpacing="110"
                                Foreground="{ThemeResource BrandPrimaryBrush}"
                                Text="SYNC BY EAR" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{ThemeResource PlayerSecondaryForegroundBrush}"
                                Text="Click a line the moment it begins" />
                        </StackPanel>
                        <Border
                            Grid.Column="1"
                            Padding="10,4"
                            VerticalAlignment="Center"
                            Background="{ThemeResource PlayerBadgeBackgroundBrush}"
                            CornerRadius="999">
                            <TextBlock
                                x:Name="LyricSyncValueText"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource PlayerForegroundBrush}"
                                Text="0.0 s" />
                        </Border>
                        <Button
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Finish subtitle sync"
                            Click="LyricSyncClose_Click"
                            Content="Done"
                            Style="{StaticResource PlayerTextButtonStyle}" />
                    </Grid>

                    <StackPanel
                        x:Name="LyricLinesPanel"
                        Margin="0,4,0,4"
                        Spacing="2" />

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="10"
                            Foreground="{ThemeResource PlayerTertiaryForegroundBrush}"
                            Text="The bright line is where the subtitles are now · Space pauses · ← → fine-tune"
                            TextWrapping="Wrap" />
                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="6"
                            VerticalAlignment="Center">
                            <Button
                                x:Name="LyricSyncEarlierButton"
                                AutomationProperties.Name="Show subtitles 50 milliseconds earlier"
                                Click="LyricSyncEarlier_Click"
                                Content="− 50 ms"
                                Style="{StaticResource PlayerTextButtonStyle}" />
                            <Button
                                x:Name="LyricSyncLaterButton"
                                AutomationProperties.Name="Show subtitles 50 milliseconds later"
                                Click="LyricSyncLater_Click"
                                Content="+ 50 ms"
                                Style="{StaticResource PlayerTextButtonStyle}" />
                            <HyperlinkButton
                                x:Name="LyricSyncUndoButton"
                                Padding="8,0"
                                AutomationProperties.Name="Undo the last timing change"
                                Click="LyricSyncUndo_Click"
                                Content="Undo"
                                FontSize="11"
                                MinHeight="0"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!--  Timing confirmation, clear of the video and the lyrics  -->
        <Border
            x:Name="LyricSyncToast"
            Margin="0,84,0,0"
            Padding="10,6,6,6"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Background="{ThemeResource PlayerPanelBackgroundBrush}"
            BorderBrush="{ThemeResource PlayerPanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource PlayerSecondaryForegroundBrush}"
                    Text="Timing" />
                <TextBlock
                    x:Name="LyricSyncToastValue"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource PlayerForegroundBrush}"
                    AutomationProperties.LiveSetting="Polite"
                    Text="0.0 s" />
                <HyperlinkButton
                    Padding="6,2"
                    AutomationProperties.Name="Undo the last timing change"
                    Click="LyricSyncUndo_Click"
                    Content="Undo"
                    FontSize="12"
                    MinHeight="0" />
            </StackPanel>
        </Border>

        <!--  Resume hint, kept outside the chrome so it survives auto-hide  -->
        <Border
            x:Name="ResumePanel"
            Margin="0,84,26,0"
            Padding="12,6,6,6"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Background="{ThemeResource PlayerPanelBackgroundBrush}"
            BorderBrush="{ThemeResource PlayerPanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon
                    FontSize="12"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource PlayerSecondaryForegroundBrush}"
                    Glyph="&#xE81C;" />
                <TextBlock
                    x:Name="ResumeText"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource PlayerForegroundBrush}"
                    Text="Resuming…" />
                <HyperlinkButton
                    x:Name="StartOverButton"
                    Padding="6,2"
                    AutomationProperties.Name="Start over from the beginning"
                    Click="StartOver_Click"
                    Content="Start over"
                    FontSize="12"
                    MinHeight="0"
                    ToolTipService.ToolTip="Start from the beginning" />
            </StackPanel>
        </Border>

        <!--
            Skip button for a detected intro, recap or outro. It stays outside
            the chrome so it can be pressed while the controls are hidden, and
            fades after a few seconds like the player chrome.
        -->
        <Border
            x:Name="SkipSegmentPanel"
            Margin="0,0,26,200"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            CornerRadius="8"
            Visibility="Collapsed">
            <Button
                x:Name="SkipSegmentButton"
                Height="40"
                Padding="16,0"
                AutomationProperties.Name="Skip segment"
                Background="{ThemeResource PlayerPanelBackgroundBrush}"
                BorderBrush="{ThemeResource PlayerPanelBorderBrush}"
                BorderThickness="1"
                Click="SkipSegment_Click"
                CornerRadius="8"
                Foreground="{ThemeResource PlayerForegroundBrush}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon
                        FontSize="14"
                        Foreground="{ThemeResource BrandPrimaryBrush}"
                        Glyph="&#xE893;" />
                    <TextBlock
                        x:Name="SkipSegmentText"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Text="Skip intro" />
                </StackPanel>
            </Button>
        </Border>

        <!--  Up next card, shown shortly before the episode ends  -->
        <Border
            x:Name="UpNextPanel"
            Width="370"
            Margin="0,0,26,104"
            Padding="12"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="{ThemeResource PlayerPanelBackgroundBrush}"
            BorderBrush="{ThemeResource PlayerPanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Visibility="Collapsed">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="112"
                    Height="63"
                    VerticalAlignment="Center"
                    Background="{ThemeResource PlayerBadgeBackgroundBrush}"
                    CornerRadius="6">
                    <Grid>
                        <FontIcon
                            AutomationProperties.AccessibilityView="Raw"
                            FontSize="18"
                            Foreground="{ThemeResource PlayerTertiaryForegroundBrush}"
                            Glyph="&#xE714;"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                        <Image
                            AutomationProperties.AccessibilityView="Raw"
                            Source="{x:Bind ViewModel.NextEpisodeImage}"
                            Stretch="UniformToFill" />
                    </Grid>
                </Border>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="3">
                    <TextBlock
                        CharacterSpacing="110"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource PlayerSecondaryForegroundBrush}"
                        Text="UP NEXT" />
                    <TextBlock
                        MaxLines="2"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource PlayerForegroundBrush}"
                        Text="{x:Bind ViewModel.NextEpisodeLine}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="UpNextCountdownText"
                        FontSize="11"
                        Foreground="{ThemeResource PlayerSecondaryForegroundBrush}"
                        Text="Playing next in 10 seconds"
                        Visibility="Collapsed" />
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="2"
                    VerticalAlignment="Center">
                    <Button
                        Padding="12,5"
                        AutomationProperties.Name="Play next episode"
                        Click="PlayNext_Click"
                        Content="Play next"
                        FontSize="12"
                        MinHeight="0"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="Play the next episode now" />
                    <Button
                        Width="30"
                        Height="30"
                        AutomationProperties.Name="Don't play next episode"
                        Click="DismissUpNext_Click"
                        Style="{StaticResource PlayerIconButtonStyle}"
                        ToolTipService.ToolTip="Don't play next">
                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--  Source discovery / startup  -->
        <Grid x:Name="LoadingOverlay" Background="{ThemeResource PlayerSurfaceBrush}">
            <Border Opacity="{ThemeResource HeroImageOpacity}">
                <Border.Background>
                    <ImageBrush ImageSource="{x:Bind ViewModel.LoadingArtworkImage, Mode=OneWay}" Stretch="UniformToFill" />
                </Border.Background>
            </Border>
            <Border Background="{ThemeResource PlayerLoadingScrimBrush}" />

            <Button
                AutomationProperties.Name="Back"
                Click="Back_Click"
                Margin="24,14,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Style="{StaticResource PlayerIconButtonStyle}"
                ToolTipService.ToolTip="Back">
                <FontIcon FontSize="18" Glyph="&#xE72B;" />
            </Button>

            <StackPanel
                MaxWidth="620"
                Margin="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
                <Grid
                    x:Name="LoadingBrand"
                    MaxWidth="440"
                    HorizontalAlignment="Center"
                    RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <CompositeTransform />
                    </Grid.RenderTransform>
                    <Image
                        MaxWidth="420"
                        MaxHeight="132"
                        HorizontalAlignment="Center"
                        AutomationProperties.Name="{x:Bind ViewModel.Title}"
                        Source="{x:Bind ViewModel.LogoImage, Mode=OneWay}"
                        Stretch="Uniform"
                        Visibility="{x:Bind helpers:XamlHelpers.Visible(ViewModel.HasLogo), Mode=OneWay}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="34"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource PlayerForegroundBrush}"
                        Text="{x:Bind ViewModel.Title}"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind helpers:XamlHelpers.Visible(ViewModel.NoLogo), Mode=OneWay}" />
                </Grid>
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="13"
                    Foreground="{ThemeResource PlayerSecondaryForegroundBrush}"
                    Text="{x:Bind ViewModel.Subtitle}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <ProgressRing
                    x:Name="LoadingRing"
                    Width="26"
                    Height="26"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Center"
                    IsActive="True" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource PlayerSecondaryForegroundBrush}"
                    Text="{x:Bind ViewModel.StatusText}" />
            </StackPanel>
        </Grid>

        <!--  Playback error  -->
        <Grid
            x:Name="ErrorPanel"
            Background="{ThemeResource PlayerOverlayScrimBrush}"
            Visibility="Collapsed">
            <Border
                MaxWidth="560"
                Padding="26"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource PlayerPanelBackgroundBrush}"
                BorderBrush="{ThemeResource PlayerPanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel Spacing="12">
                    <FontIcon
                        FontSize="28"
                        Foreground="{ThemeResource PlayerForegroundBrush}"
                        Glyph="&#xE7BA;" />
                    <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource PlayerForegroundBrush}"
                        Text="Couldn't play this source" />
                    <TextBlock
                        x:Name="ErrorText"
                        FontSize="13"
                        Foreground="{ThemeResource PlayerSecondaryForegroundBrush}"
                        TextWrapping="Wrap" />
                    <StackPanel
                        Margin="0,6,0,0"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            x:Name="RetryButton"
                            Click="Retry_Click"
                            Content="Retry"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button
                            x:Name="NextSourceButton"
                            Click="NextSource_Click"
                            Content="Next source" />
                        <Button
                            AutomationProperties.Name="Choose an episode"
                            Click="OpenEpisodes_Click"
                            Content="Episodes"
                            Visibility="{x:Bind helpers:XamlHelpers.Visible(ViewModel.CanBrowseEpisodes)}" />
                        <Button Click="Back_Click" Content="Back" />
                        <Button
                            AutomationProperties.Name="Manage addons"
                            Click="ManageAddons_Click"
                            Content="Manage addons" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
