<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Pirsa.Views.AddonsSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:Pirsa.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:Pirsa.Services"
    x:DefaultBindMode="OneWay"
    Background="{ThemeResource AppBackgroundBrush}"
    NavigationCacheMode="Disabled"
    mc:Ignorable="d">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto">
        <Grid
            Margin="32,26,32,64"
            HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="820" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="18">
                <!--  Header  -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="6">
                        <TextBlock Style="{StaticResource SettingsPageTitleTextBlockStyle}" Text="Add-ons" />
                        <TextBlock
                            Style="{StaticResource SettingsPageSubtitleTextBlockStyle}"
                            Text="Add-ons supply catalogs, metadata, subtitles and sources. Only add ones you trust." />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Top">
                        <ProgressRing
                            Width="16"
                            Height="16"
                            Margin="4,8,0,0"
                            IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                            Visibility="{x:Bind helpers:XamlHelpers.Visible(ViewModel.IsBusy), Mode=OneWay}" />
                        <Button
                            x:Name="RestoreDefaultsButton"
                            AutomationProperties.Name="More add-on options"
                            ToolTipService.ToolTip="More options">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Click="RestoreDefaults_Click" Text="Restore default add-ons" />
                                </MenuFlyout>
                            </Button.Flyout>
                            <FontIcon FontSize="14" Glyph="&#xE712;" />
                        </Button>
                        <Button
                            x:Name="AddAddonButton"
                            AutomationProperties.Name="Add add-on"
                            Click="AddAddon_Click"
                            Content="Add add-on"
                            Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </Grid>

                <TextBlock
                    x:Name="AddonsSummary"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.AddonCountText, Mode=OneWay}" />

                <InfoBar
                    Title="Add-on problem"
                    IsClosable="True"
                    IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    Severity="Error" />

                <InfoBar
                    Title="Add-ons updated"
                    Closed="Notice_Closed"
                    IsClosable="True"
                    IsOpen="{x:Bind ViewModel.HasNotice, Mode=OneWay}"
                    Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}"
                    Severity="Informational" />

                <!--  Search and filter, only with a long list  -->
                <StackPanel
                    Spacing="8"
                    Visibility="{x:Bind helpers:XamlHelpers.Visible(ViewModel.HasManyAddons), Mode=OneWay}">
                    <TextBox
                        MaxWidth="420"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="AddonSearchBox"
                        AutomationProperties.Name="Search add-ons"
                        PlaceholderText="Search by name or host"
                        Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <SelectorBar
                            x:Name="AddonFilterBar"
                            AutomationProperties.Name="Filter add-ons"
                            SelectionChanged="AddonFilter_SelectionChanged">
                            <SelectorBarItem
                                IsSelected="True"
                                Tag="0"
                                Text="All" />
                            <SelectorBarItem Tag="1" Text="Streams" />
                            <SelectorBarItem Tag="2" Text="Metadata" />
                            <SelectorBarItem Tag="3" Text="Catalogs" />
                            <SelectorBarItem Tag="4" Text="Issues" />
                        </SelectorBar>
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.VisibleCountText, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>

                <!--  Add-on list  -->
                <ListView
                    x:Name="AddonList"
                    AllowDrop="{x:Bind ViewModel.CanReorder, Mode=OneWay}"
                    CanReorderItems="{x:Bind ViewModel.CanReorder, Mode=OneWay}"
                    DragItemsCompleted="AddonList_DragItemsCompleted"
                    HorizontalContentAlignment="Stretch"
                    IsItemClickEnabled="False"
                    ItemsSource="{x:Bind ViewModel.VisibleAddons}"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollMode="Disabled"
                    SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,8" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="CornerRadius" Value="8" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="services:AddonEntry">
                            <Border
                                Padding="16"
                                Style="{StaticResource SettingsGroupBorderStyle}">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon
                                                FontSize="13"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                Glyph="&#xE784;"
                                                ToolTipService.ToolTip="Drag to reorder"
                                                VerticalAlignment="Center" />
                                            <Border
                                                Padding="7,2"
                                                VerticalAlignment="Center"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="4">
                                                <TextBlock
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind Order, Mode=OneWay}" />
                                            </Border>
                                            <TextBlock
                                                FontSize="15"
                                                FontWeight="SemiBold"
                                                Text="{x:Bind Name, Mode=OneWay}" />
                                            <Border
                                                Padding="7,2"
                                                VerticalAlignment="Center"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="4"
                                                Visibility="{x:Bind helpers:XamlHelpers.VisibleIfText(VersionText)}">
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind VersionText, Mode=OneWay}" />
                                            </Border>
                                            <Border
                                                Padding="7,2"
                                                VerticalAlignment="Center"
                                                Background="{ThemeResource BrandSubtleBrush}"
                                                CornerRadius="4"
                                                Visibility="{x:Bind helpers:XamlHelpers.Visible(IsDefault)}">
                                                <TextBlock
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource BrandPrimaryBrush}"
                                                    Text="Default" />
                                            </Border>
                                            <Border
                                                Padding="7,2"
                                                VerticalAlignment="Center"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="4"
                                                Visibility="{x:Bind helpers:XamlHelpers.Collapsed(IsEnabled), Mode=OneWay}">
                                                <TextBlock
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="Disabled" />
                                            </Border>
                                        </StackPanel>

                                        <TextBlock
                                            MaxLines="2"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Text="{x:Bind DescriptionText, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap"
                                            Visibility="{x:Bind helpers:XamlHelpers.Visible(HasDescription)}" />

                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Text="{x:Bind Host}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="Manifest URL is stored locally and hidden here." />

                                        <StackPanel
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            Visibility="{x:Bind helpers:XamlHelpers.Visible(IsLoading), Mode=OneWay}">
                                            <ProgressRing
                                                Width="14"
                                                Height="14"
                                                IsActive="{x:Bind IsLoading, Mode=OneWay}" />
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="Loading manifest…" />
                                        </StackPanel>

                                        <StackPanel
                                            Orientation="Horizontal"
                                            Spacing="6"
                                            Visibility="{x:Bind helpers:XamlHelpers.Visible(HasError), Mode=OneWay}">
                                            <FontIcon
                                                FontSize="12"
                                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                Glyph="&#xE7BA;" />
                                            <TextBlock
                                                MaxWidth="560"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind LoadError, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="Wrap" />
                                            <HyperlinkButton
                                                Padding="4,0"
                                                Click="RetryAddon_Click"
                                                Content="Retry" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        Orientation="Horizontal"
                                        Spacing="4"
                                        VerticalAlignment="Center">
                                        <ToggleSwitch
                                            HorizontalAlignment="Right"
                                            AutomationProperties.HelpText="{x:Bind Name, Mode=OneWay}"
                                            AutomationProperties.Name="Enable addon"
                                            IsOn="{x:Bind IsEnabled, Mode=OneWay}"
                                            MinWidth="0"
                                            OffContent=""
                                            OnContent=""
                                            Toggled="AddonEnabled_Toggled" />
                                        <Button
                                            Width="34"
                                            Height="32"
                                            MinWidth="0"
                                            Padding="0"
                                            AutomationProperties.HelpText="{x:Bind Name, Mode=OneWay}"
                                            AutomationProperties.Name="More addon actions"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            CornerRadius="6"
                                            ToolTipService.ToolTip="More actions">
                                            <Button.Flyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem
                                                        Click="MoveAddonUp_Click"
                                                        IsEnabled="{x:Bind CanMoveUp, Mode=OneWay}"
                                                        Tag="{x:Bind}"
                                                        Text="Move up" />
                                                    <MenuFlyoutItem
                                                        Click="MoveAddonDown_Click"
                                                        IsEnabled="{x:Bind CanMoveDown, Mode=OneWay}"
                                                        Tag="{x:Bind}"
                                                        Text="Move down" />
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem
                                                        Click="RemoveAddon_Click"
                                                        Tag="{x:Bind}"
                                                        Text="Remove" />
                                                </MenuFlyout>
                                            </Button.Flyout>
                                            <FontIcon
                                                FontSize="15"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Glyph="&#xE712;" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Order is priority. The first enabled metadata add-on supplies details; stream sources are listed in this order."
                    TextWrapping="Wrap"
                    Visibility="{x:Bind helpers:XamlHelpers.Visible(ViewModel.HasAddons), Mode=OneWay}" />

                <Border
                    Padding="24"
                    Style="{StaticResource SettingsGroupBorderStyle}"
                    Visibility="{x:Bind helpers:XamlHelpers.Visible(ViewModel.HasNoMatches), Mode=OneWay}">
                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="No add-ons match" />
                        <TextBlock
                            MaxWidth="420"
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="Try a different name or host, or clear the search and filter."
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <Button
                            HorizontalAlignment="Center"
                            Click="ClearAddonFilters_Click"
                            Content="Clear filters" />
                    </StackPanel>
                </Border>

                <Border
                    Padding="28"
                    Style="{StaticResource SettingsGroupBorderStyle}"
                    Visibility="{x:Bind helpers:XamlHelpers.Visible(ViewModel.IsEmpty), Mode=OneWay}">
                    <StackPanel HorizontalAlignment="Center" Spacing="10">
                        <FontIcon
                            FontSize="28"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE8FD;"
                            HorizontalAlignment="Center" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            HorizontalTextAlignment="Center"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="No add-ons configured" />
                        <TextBlock
                            MaxWidth="460"
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="Add an add-on, or restore the default metadata add-on to browse movies and series again."
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <Button
                            HorizontalAlignment="Center"
                            Click="RestoreDefaults_Click"
                            Content="Restore defaults" />
                    </StackPanel>
                </Border>

                <!--  Advanced  -->
                <Expander
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Header="Advanced">
                    <Border
                        Margin="0,4,0,0"
                        Style="{StaticResource SettingsGroupBorderStyle}">
                        <StackPanel x:Name="LinkHandlingRow">
                            <Border
                                Padding="16,13"
                                Visibility="{x:Bind helpers:XamlHelpers.Visible(ViewModel.CanManageLinkRegistration), Mode=OneWay}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SettingsRowTitleTextBlockStyle}" Text="Open stremio:// links in Pirsa" />
                                        <TextBlock
                                            Style="{StaticResource SettingsRowDescriptionTextBlockStyle}"
                                            Text="For portable copies. The installer registers this for you, and Pirsa always asks before adding an add-on from a link." />
                                    </StackPanel>
                                    <ToggleSwitch
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Open stremio links in Pirsa"
                                        IsOn="{x:Bind ViewModel.HandlesStremioLinks, Mode=TwoWay}"
                                        OffContent="Off"
                                        OnContent="On" />
                                </Grid>
                            </Border>

                            <Border
                                Padding="16,13"
                                Visibility="{x:Bind helpers:XamlHelpers.Visible(ViewModel.IsPackagedBuild), Mode=OneWay}">
                                <TextBlock
                                    Style="{StaticResource SettingsRowDescriptionTextBlockStyle}"
                                    Text="This build handles stremio:// links through its app package. Another app can take over in Windows Settings → Apps → Default apps." />
                            </Border>
                        </StackPanel>
                    </Border>
                </Expander>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
