<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Pirsa.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:Pirsa.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:DefaultBindMode="OneWay"
    Background="{ThemeResource AppBackgroundBrush}"
    mc:Ignorable="d">

    <NavigationView
        x:Name="SettingsNav"
        AlwaysShowHeader="False"
        Background="{ThemeResource AppBackgroundBrush}"
        CompactPaneLength="48"
        IsBackButtonVisible="Collapsed"
        IsPaneOpen="True"
        IsPaneToggleButtonVisible="False"
        IsSettingsVisible="False"
        OpenPaneLength="248"
        PaneDisplayMode="Left"
        SelectionChanged="SettingsNav_SelectionChanged"
        SelectionFollowsFocus="Disabled">

        <NavigationView.PaneHeader>
            <StackPanel
                Padding="0,6,0,10"
                Spacing="10">
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="BackButton"
                        Width="32"
                        Height="32"
                        Padding="0"
                        AutomationProperties.Name="Back"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="Back_Click"
                        Visibility="Collapsed">
                        <FontIcon FontSize="14" Glyph="&#xE72B;" />
                    </Button>
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontFamily="Segoe UI Variable Display"
                        FontSize="24"
                        FontWeight="SemiBold"
                        Text="Settings" />
                </Grid>

                <AutoSuggestBox
                    x:Name="SettingsSearch"
                    MinWidth="196"
                    Margin="12,0"
                    AutomationProperties.Name="Search settings"
                    KeyDown="SettingsSearch_KeyDown"
                    PlaceholderText="Search settings"
                    QueryIcon="Find"
                    QuerySubmitted="SettingsSearch_QuerySubmitted"
                    TextChanged="SettingsSearch_TextChanged" />
            </StackPanel>
        </NavigationView.PaneHeader>

        <NavigationView.MenuItems>
            <NavigationViewItem Content="General" Tag="general">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Setting" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Playback" Tag="playback">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Play" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Subtitles" Tag="subtitles">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Caption" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Library &amp; data" Tag="library">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Library" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Add-ons" Tag="addons">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="ViewAll" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Sync" Tag="sync">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Sync" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="About" Tag="about">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Help" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <Grid>
            <Frame x:Name="SettingsFrame" Navigated="SettingsFrame_Navigated" />

            <!--  Search results replace the page without moving the category pane.  -->
            <Grid
                x:Name="SearchOverlay"
                Background="{ThemeResource AppBackgroundBrush}"
                KeyDown="SettingsSearch_KeyDown"
                Visibility="Collapsed">
                <ScrollViewer
                    HorizontalContentAlignment="Center"
                    HorizontalScrollBarVisibility="Disabled"
                    HorizontalScrollMode="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <Grid
                        Margin="32,26,32,64"
                        HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="820" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="18">
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource SettingsPageTitleTextBlockStyle}" Text="Search" />
                                <TextBlock
                                    x:Name="SearchSummary"
                                    Style="{StaticResource SettingsPageSubtitleTextBlockStyle}"
                                    Text="Type to find a setting." />
                            </StackPanel>

                            <Border Style="{StaticResource SettingsGroupBorderStyle}">
                                <ListView
                                    x:Name="SearchResults"
                                    HorizontalContentAlignment="Stretch"
                                    IsItemClickEnabled="True"
                                    ItemClick="SearchResults_ItemClick"
                                    SelectionMode="None">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="MinHeight" Value="0" />
                                            <Setter Property="Padding" Value="0" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="helpers:SettingsSearchEntry">
                                            <Grid
                                                Padding="16,12"
                                                ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="2">
                                                    <TextBlock Style="{StaticResource SettingsRowTitleTextBlockStyle}" Text="{x:Bind Title, Mode=OneTime}" />
                                                    <TextBlock Style="{StaticResource SettingsRowDescriptionTextBlockStyle}" Text="{x:Bind Detail, Mode=OneTime}" />
                                                </StackPanel>
                                                <FontIcon
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                    Glyph="&#xE76C;" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Border>

                            <TextBlock
                                x:Name="NoResults"
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="No settings match. Try a shorter word, like “quality” or “subtitle”."
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </NavigationView>
</Page>
