<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Pirsa.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:Pirsa.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:Pirsa.Services"
    x:DefaultBindMode="OneWay"
    Background="{ThemeResource AppBackgroundBrush}"
    NavigationCacheMode="Required"
    mc:Ignorable="d">
    <Page.Resources>
        <DataTemplate x:Key="WatchlistCardTemplate" x:DataType="services:WatchlistEntry">
            <Grid Width="168" ContextRequested="Card_ContextRequested">
                <StackPanel Spacing="7">
                    <Border
                        Width="168"
                        Height="252"
                        Background="{ThemeResource PosterPlaceholderBrush}"
                        BorderBrush="{ThemeResource CardStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                        <Grid>
                            <FontIcon
                                AutomationProperties.AccessibilityView="Raw"
                                FontSize="28"
                                Foreground="{ThemeResource PosterPlaceholderForegroundBrush}"
                                Glyph="&#xE8B2;"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{x:Bind helpers:XamlHelpers.Collapsed(HasPoster)}" />

                            <Image
                                AutomationProperties.AccessibilityView="Raw"
                                Source="{x:Bind PosterImage}"
                                Stretch="UniformToFill" />

                            <Border
                                Margin="8"
                                Padding="6,2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                Background="{ThemeResource OverlayChipBackgroundBrush}"
                                CornerRadius="4"
                                Visibility="{x:Bind helpers:XamlHelpers.VisibleIfText(CardMeta)}">
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource OverlayChipForegroundBrush}"
                                    Text="{x:Bind CardMeta}" />
                            </Border>
                        </Grid>
                    </Border>

                    <TextBlock
                        MaxLines="2"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind Name}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="WrapWholeWords" />

                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind TypeLabel}"
                        TextTrimming="CharacterEllipsis" />

                    <TextBlock
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="{x:Bind AddedText}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid
            Grid.Row="0"
            Margin="40,26,40,6">
            <StackPanel Spacing="4">
                <TextBlock
                    FontSize="32"
                    FontWeight="SemiBold"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Watchlist" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="Movies and series you saved from their details page. Select one to open it, or right-click a card to remove it. Stored on this device only."
                    TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Orientation="Horizontal"
                Spacing="12"
                Visibility="{x:Bind helpers:XamlHelpers.Visible(ViewModel.HasItems), Mode=OneWay}">
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource SectionSubtitleTextBlockStyle}"
                    Text="{x:Bind ViewModel.CountText, Mode=OneWay}" />
                <Button Click="Clear_Click" Content="Clear watchlist" />
            </StackPanel>
        </Grid>

        <!--  Saved titles  -->
        <GridView
            x:Name="ItemsGrid"
            Grid.Row="1"
            Margin="40,10,40,40"
            Padding="0"
            AutomationProperties.Name="Watchlist titles"
            IsItemClickEnabled="True"
            ItemClick="Items_ItemClick"
            ItemContainerStyle="{StaticResource PosterGridViewItemStyle}"
            ItemTemplate="{StaticResource WatchlistCardTemplate}"
            ItemsSource="{x:Bind ViewModel.Items}"
            SelectionMode="None"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.HorizontalScrollMode="Disabled"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            Visibility="{x:Bind helpers:XamlHelpers.Visible(ViewModel.HasItems), Mode=OneWay}" />

        <!--  Empty watchlist  -->
        <Grid
            Grid.Row="1"
            Visibility="{x:Bind helpers:XamlHelpers.Visible(ViewModel.IsEmpty), Mode=OneWay}">
            <StackPanel
                MaxWidth="460"
                Margin="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
                <Viewbox
                    Width="34"
                    Height="34"
                    HorizontalAlignment="Center"
                    AutomationProperties.AccessibilityView="Raw">
                    <SymbolIcon
                        Foreground="{ThemeResource BrandPrimaryBrush}"
                        Symbol="Bookmarks" />
                </Viewbox>                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="Your watchlist is empty"
                    TextAlignment="Center" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="Open any movie or series and choose Add to watchlist to keep it here for later."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    Click="Browse_Click"
                    Content="Browse titles"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
