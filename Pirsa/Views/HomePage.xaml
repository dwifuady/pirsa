<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Pirsa.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:Pirsa.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Pirsa.Models"
    xmlns:services="using:Pirsa.Services"
    xmlns:vm="using:Pirsa.ViewModels"
    x:DefaultBindMode="OneWay"
    Background="{ThemeResource AppBackgroundBrush}"
    NavigationCacheMode="Required"
    mc:Ignorable="d">
    <Page.Resources>
        <DataTemplate x:Key="PosterCardTemplate" x:DataType="models:MetaItem">
            <Grid Width="168">
                <StackPanel Spacing="7">
                    <Border
                        Width="168"
                        Height="252"
                        Background="{ThemeResource PosterPlaceholderBrush}"
                        BorderBrush="{ThemeResource CardStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                        <Grid>
                            <FontIcon
                                AutomationProperties.AccessibilityView="Raw"
                                FontSize="28"
                                Foreground="{ThemeResource PosterPlaceholderForegroundBrush}"
                                Glyph="&#xE8B2;"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{x:Bind helpers:XamlHelpers.Visible(HasNoPoster)}" />

                            <Image
                                AutomationProperties.AccessibilityView="Raw"
                                Source="{x:Bind PosterCardImage}"
                                Stretch="UniformToFill" />

                            <Border
                                Margin="8"
                                Padding="6,2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                Background="{ThemeResource OverlayChipBackgroundBrush}"
                                CornerRadius="4"
                                Visibility="{x:Bind helpers:XamlHelpers.Visible(HasRating)}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon
                                        FontSize="9"
                                        Foreground="{ThemeResource OverlayChipForegroundBrush}"
                                        Glyph="&#xE735;" />
                                    <TextBlock
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource OverlayChipForegroundBrush}"
                                        Text="{x:Bind RatingText}" />
                                </StackPanel>
                            </Border>

                            <Border
                                Margin="8"
                                Padding="6,2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="{ThemeResource OverlayChipBackgroundBrush}"
                                CornerRadius="4"
                                Visibility="{x:Bind helpers:XamlHelpers.Visible(HasWatchBadge)}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon
                                        FontSize="9"
                                        Foreground="{ThemeResource OverlayChipForegroundBrush}"
                                        Glyph="&#xE73E;" />
                                    <TextBlock
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource OverlayChipForegroundBrush}"
                                        Text="{x:Bind WatchBadgeText}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <TextBlock
                        MaxLines="2"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind Name}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="WrapWholeWords" />

                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind CardMeta}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ContinueCardTemplate" x:DataType="services:WatchProgressEntry">
            <Grid Width="168" RightTapped="ContinueCard_RightTapped">
                <StackPanel Spacing="7">
                    <Border
                        Width="168"
                        Height="252"
                        Background="{ThemeResource PosterPlaceholderBrush}"
                        BorderBrush="{ThemeResource CardStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                        <Grid>
                            <FontIcon
                                AutomationProperties.AccessibilityView="Raw"
                                FontSize="28"
                                Foreground="{ThemeResource PosterPlaceholderForegroundBrush}"
                                Glyph="&#xE8B2;"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{x:Bind helpers:XamlHelpers.Collapsed(HasPoster)}" />

                            <Image
                                AutomationProperties.AccessibilityView="Raw"
                                Source="{x:Bind PosterImage}"
                                Stretch="UniformToFill" />

                            <ProgressBar
                                Height="4"
                                Margin="8,0,8,9"
                                VerticalAlignment="Bottom"
                                AutomationProperties.Name="Playback progress"
                                Background="{ThemeResource OverlayChipBackgroundBrush}"
                                Foreground="{ThemeResource BrandPrimaryBrush}"
                                Maximum="1"
                                Value="{x:Bind ProgressFraction}" />
                        </Grid>
                    </Border>

                    <TextBlock
                        MaxLines="2"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind Name}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="WrapWholeWords" />

                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind SubtitleLine}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <ScrollViewer
            x:Name="HomeScrollViewer"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!--  Hero / Top 10 carousel  -->
                <Grid x:Name="HeroHost" Height="470">
                    <FlipView
                        x:Name="HeroFlip"
                        AutomationProperties.Name="Top 10 carousel"
                        ItemsSource="{x:Bind ViewModel.HeroItems}"
                        SelectionChanged="HeroFlip_SelectionChanged"
                        UseTouchAnimationsForAllNavigation="True">
                        <FlipView.ItemTemplate>
                            <DataTemplate x:DataType="vm:HeroItemViewModel">
                                <Grid Background="{ThemeResource AppBackgroundBrush}">
                                    <Border Background="{ThemeResource PosterPlaceholderBrush}" />
                                    <Image
                                        AutomationProperties.AccessibilityView="Raw"
                                        Opacity="{ThemeResource HeroImageOpacity}"
                                        Source="{x:Bind BackgroundImage}"
                                        Stretch="UniformToFill" />

                                    <Border Background="{ThemeResource HeroLeftScrimBrush}" />
                                    <Border
                                        Height="120"
                                        VerticalAlignment="Top"
                                        Background="{ThemeResource HeroTopScrimBrush}" />
                                    <Border
                                        Height="340"
                                        VerticalAlignment="Bottom"
                                        Background="{ThemeResource HeroBottomScrimBrush}" />
                                    <Border
                                        Height="56"
                                        VerticalAlignment="Bottom"
                                        Background="{ThemeResource HeroPageBlendBrush}" />

                                    <StackPanel
                                        MaxWidth="700"
                                        Margin="64,0,0,72"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Bottom"
                                        Spacing="13">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Border
                                                Padding="8,3"
                                                VerticalAlignment="Center"
                                                Background="{ThemeResource HeroBadgeBackgroundBrush}"
                                                CornerRadius="4">
                                                <TextBlock
                                                    CharacterSpacing="100"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource HeroBadgeForegroundBrush}"
                                                    Text="TOP 10" />
                                            </Border>

                                            <Border
                                                Padding="8,3"
                                                VerticalAlignment="Center"
                                                Background="{ThemeResource HeroBadgeBackgroundBrush}"
                                                CornerRadius="4"
                                                Visibility="{x:Bind helpers:XamlHelpers.Visible(HasWatchBadge)}">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <FontIcon
                                                        FontSize="11"
                                                        Foreground="{ThemeResource HeroBadgeForegroundBrush}"
                                                        Glyph="&#xE73E;" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        FontWeight="SemiBold"
                                                        Foreground="{ThemeResource HeroBadgeForegroundBrush}"
                                                        Text="{x:Bind WatchBadgeText}" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock
                                                MaxWidth="420"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource HeroOverlineTextBlockStyle}"
                                                Text="{x:Bind SourceLine}" />
                                        </StackPanel>

                                        <Image
                                            MaxWidth="420"
                                            MaxHeight="78"
                                            Margin="0,2,0,2"
                                            HorizontalAlignment="Left"
                                            AutomationProperties.Name="{x:Bind Title}"
                                            Source="{x:Bind LogoImage}"
                                            Stretch="Uniform"
                                            Visibility="{x:Bind helpers:XamlHelpers.Visible(HasLogo)}" />

                                        <TextBlock
                                            MaxLines="2"
                                            Style="{StaticResource HeroTitleTextBlockStyle}"
                                            Text="{x:Bind Title}"
                                            Visibility="{x:Bind helpers:XamlHelpers.Visible(NoLogo)}" />

                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <StackPanel
                                                Orientation="Horizontal"
                                                Spacing="6"
                                                VerticalAlignment="Center"
                                                Visibility="{x:Bind helpers:XamlHelpers.Visible(HasRating)}">
                                                <FontIcon
                                                    FontSize="12"
                                                    Foreground="{ThemeResource HeroTextBrush}"
                                                    Glyph="&#xE735;" />
                                                <TextBlock
                                                    Style="{StaticResource HeroMetaTextBlockStyle}"
                                                    Text="{x:Bind RatingText}" />
                                            </StackPanel>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Style="{StaticResource HeroOverlineTextBlockStyle}"
                                                Text="{x:Bind MetaLine}" />
                                        </StackPanel>

                                        <TextBlock
                                            MaxWidth="620"
                                            MaxLines="3"
                                            HorizontalAlignment="Left"
                                            IsTextSelectionEnabled="False"
                                            Style="{StaticResource HeroBodyTextBlockStyle}"
                                            Text="{x:Bind Description}"
                                            TextTrimming="CharacterEllipsis"
                                            Visibility="{x:Bind helpers:XamlHelpers.Visible(HasDescription)}" />

                                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal" Spacing="12">
                                            <Button
                                                AutomationProperties.Name="Play"
                                                Click="HeroPlay_Click"
                                                Style="{StaticResource HeroPrimaryButtonStyle}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon
                                                        FontSize="14"
                                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                        Glyph="&#xE768;" />
                                                    <TextBlock Text="Play" />
                                                </StackPanel>
                                            </Button>

                                            <Button
                                                AutomationProperties.Name="More info"
                                                Click="HeroInfo_Click"
                                                Style="{StaticResource HeroSecondaryButtonStyle}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon
                                                        FontSize="14"
                                                        Foreground="{ThemeResource HeroSecondaryButtonForegroundBrush}"
                                                        Glyph="&#xE946;" />
                                                    <TextBlock Text="More info" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock
                                        Margin="0,0,58,96"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        AutomationProperties.AccessibilityView="Raw"
                                        FontSize="148"
                                        FontWeight="Bold"
                                        Foreground="{ThemeResource HeroTextBrush}"
                                        IsHitTestVisible="False"
                                        Opacity="0.14"
                                        Text="{x:Bind RankText}" />
                                </Grid>
                            </DataTemplate>
                        </FlipView.ItemTemplate>
                    </FlipView>

                    <PipsPager
                        x:Name="HeroPager"
                        MaxVisiblePips="10"
                        Margin="0,0,56,56"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        AutomationProperties.Name="Featured title pages"
                        NumberOfPages="{x:Bind ViewModel.HeroSlides, Mode=OneWay}"
                        SelectedIndexChanged="HeroPager_SelectedIndexChanged">
                        <PipsPager.Resources>
                            <StaticResource x:Key="PipsPagerSelectionIndicatorForeground" ResourceKey="HeroPipForegroundBrush" />
                            <StaticResource x:Key="PipsPagerSelectionIndicatorForegroundPointerOver" ResourceKey="HeroPipHoverBrush" />
                            <StaticResource x:Key="PipsPagerSelectionIndicatorForegroundPressed" ResourceKey="HeroPipHoverBrush" />
                            <StaticResource x:Key="PipsPagerSelectionIndicatorForegroundSelected" ResourceKey="HeroPipSelectedBrush" />
                            <StaticResource x:Key="PipsPagerSelectionIndicatorForegroundDisabled" ResourceKey="HeroPipForegroundBrush" />
                        </PipsPager.Resources>
                    </PipsPager>
                </Grid>

                <!--  Continue watching  -->
                <StackPanel
                    Margin="0,26,0,0"
                    Spacing="13"
                    Visibility="{x:Bind helpers:XamlHelpers.Visible(ViewModel.HasContinueWatching), Mode=OneWay}">
                    <Grid Margin="48,0,48,0">
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="10"
                            VerticalAlignment="Center">
                            <Border
                                Width="4"
                                Height="20"
                                VerticalAlignment="Center"
                                Background="{ThemeResource BrandPrimaryBrush}"
                                CornerRadius="2" />
                            <TextBlock
                                Style="{StaticResource SectionTitleTextBlockStyle}"
                                Text="Continue watching" />
                        </StackPanel>
                        <TextBlock
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Style="{StaticResource SectionSubtitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.ContinueWatchingLabel, Mode=OneWay}" />
                    </Grid>

                    <ListView
                        Height="342"
                        Margin="42,0,0,0"
                        AutomationProperties.Name="Continue watching"
                        CanDragItems="False"
                        CanReorderItems="False"
                        IsItemClickEnabled="True"
                        ItemClick="Continue_ItemClick"
                        ItemContainerStyle="{StaticResource PosterListItemStyle}"
                        ItemContainerTransitions="{x:Null}"
                        ItemTemplate="{StaticResource ContinueCardTemplate}"
                        ItemsSource="{x:Bind ViewModel.ContinueWatching}"
                        SelectionMode="None"
                        ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                        ScrollViewer.HorizontalScrollMode="Enabled"
                        ScrollViewer.IsHorizontalRailEnabled="True"
                        ScrollViewer.IsVerticalRailEnabled="False"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollMode="Disabled">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                    </ListView>
                </StackPanel>

                <!--  Catalogs  -->
                <StackPanel Margin="0,26,0,72" Spacing="38">
                    <InfoBar
                        Margin="48,0,48,0"
                        Title="Some catalogs couldn't load"
                        IsClosable="True"
                        IsOpen="{x:Bind ViewModel.HasRowErrors, Mode=OneWay}"
                        Message="{x:Bind ViewModel.RowErrorMessage, Mode=OneWay}"
                        Severity="Warning">
                        <InfoBar.ActionButton>
                            <Button Content="Retry" Command="{x:Bind ViewModel.RetryRowsCommand}" />
                        </InfoBar.ActionButton>
                    </InfoBar>

                    <StackPanel
                        Margin="48,0,0,0"
                        Orientation="Horizontal"
                        Spacing="10"
                        Visibility="{x:Bind helpers:XamlHelpers.Visible(ViewModel.IsLoadingRows), Mode=OneWay}">
                        <ProgressRing
                            Width="16"
                            Height="16"
                            IsActive="{x:Bind ViewModel.IsLoadingRows, Mode=OneWay}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Loading more catalogs…" />
                    </StackPanel>

                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Catalogs}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="38" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:CatalogRowViewModel">
                                <StackPanel>
                                    <Grid Margin="48,0,48,13">
                                        <StackPanel
                                            Orientation="Horizontal"
                                            Spacing="10"
                                            VerticalAlignment="Center">
                                            <Border
                                                Width="4"
                                                Height="20"
                                                VerticalAlignment="Center"
                                                Background="{ThemeResource BrandPrimaryBrush}"
                                                CornerRadius="2" />
                                            <TextBlock
                                                Style="{StaticResource SectionTitleTextBlockStyle}"
                                                Text="{x:Bind Title}" />
                                            <Border
                                                Padding="7,2"
                                                VerticalAlignment="Center"
                                                Background="{ThemeResource BrandSubtleBrush}"
                                                CornerRadius="4"
                                                Visibility="{x:Bind helpers:XamlHelpers.Visible(HasSubtitle)}">
                                                <TextBlock
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource BrandPrimaryBrush}"
                                                    Text="{x:Bind Subtitle}" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel
                                            HorizontalAlignment="Right"
                                            Orientation="Horizontal"
                                            Spacing="7"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                Style="{StaticResource SectionSubtitleTextBlockStyle}"
                                                Text="{x:Bind AddonName}"
                                                Visibility="{x:Bind helpers:XamlHelpers.Visible(ShowAddonName)}" />
                                            <TextBlock
                                                Style="{StaticResource SectionSubtitleTextBlockStyle}"
                                                Text="·"
                                                Visibility="{x:Bind helpers:XamlHelpers.Visible(ShowAddonName)}" />
                                            <TextBlock
                                                Style="{StaticResource SectionSubtitleTextBlockStyle}"
                                                Text="{x:Bind CountLabel}" />
                                        </StackPanel>
                                    </Grid>

                                    <ListView
                                        Height="342"
                                        Margin="42,0,0,0"
                                        AutomationProperties.Name="{x:Bind Title}"
                                        CanDragItems="False"
                                        CanReorderItems="False"
                                        IsItemClickEnabled="True"
                                        ItemClick="Catalog_ItemClick"
                                        ItemContainerStyle="{StaticResource PosterListItemStyle}"
                                        ItemContainerTransitions="{x:Null}"
                                        ItemTemplate="{StaticResource PosterCardTemplate}"
                                        ItemsSource="{x:Bind Items}"
                                        SelectionMode="None"
                                        ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                        ScrollViewer.HorizontalScrollMode="Enabled"
                                        ScrollViewer.IsHorizontalRailEnabled="True"
                                        ScrollViewer.IsVerticalRailEnabled="False"
                                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                        ScrollViewer.VerticalScrollMode="Disabled">
                                        <ListView.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ItemsStackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ListView.ItemsPanel>
                                    </ListView>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <StackPanel
                        MaxWidth="460"
                        Margin="48,32,48,0"
                        HorizontalAlignment="Left"
                        Spacing="8"
                        Visibility="{x:Bind helpers:XamlHelpers.Visible(ViewModel.IsEmpty), Mode=OneWay}">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Nothing to browse yet" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="This addon didn't return any catalogs."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!--  Initial load  -->
        <Grid
            x:Name="LoadingOverlay"
            Background="{ThemeResource AppBackgroundBrush}"
            Visibility="{x:Bind helpers:XamlHelpers.Visible(ViewModel.IsLoading), Mode=OneWay}">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="18">
                <Image
                    Width="60"
                    Height="60"
                    AutomationProperties.AccessibilityView="Raw"
                    Source="ms-appx:///Assets/BrandMark.png" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="{x:Bind ViewModel.LoadingText, Mode=OneWay}" />
                <ProgressRing
                    Width="24"
                    Height="24"
                    HorizontalAlignment="Center"
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <!--  Fatal load error  -->
        <Grid
            Background="{ThemeResource AppBackgroundBrush}"
            Visibility="{x:Bind helpers:XamlHelpers.Visible(ViewModel.HasError), Mode=OneWay}">
            <StackPanel
                MaxWidth="480"
                Margin="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="14">
                <FontIcon
                    FontSize="34"
                    Foreground="{ThemeResource BrandPrimaryBrush}"
                    Glyph="&#xE774;" />
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Couldn't load your catalog" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <StackPanel
                    Margin="0,8,0,0"
                    Orientation="Horizontal"
                    Spacing="10">
                    <Button
                        Command="{x:Bind ViewModel.LoadCommand}"
                        Content="Try again"
                        Style="{StaticResource AccentButtonStyle}" />
                    <Button Click="ManageAddons_Click" Content="Manage addons" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
