<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Pirsa.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:Pirsa.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:Pirsa.Services"
    Title="Pirsa"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Height="48"
            BackRequested="AppTitleBar_BackRequested"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="AppTitleBar_PaneToggleRequested"
            Title="Pirsa">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/BrandMark.png" />
            </TitleBar.IconSource>
        </TitleBar>

        <!--  Centered in the window (not just in the title-bar content slot).  -->
        <AutoSuggestBox
            x:Name="AppSearchBox"
            Grid.Row="0"
            Width="460"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            AutomationProperties.Name="Search titles"
            PlaceholderText="Search across your addons"
            QueryIcon="Find"
            QuerySubmitted="AppSearchBox_QuerySubmitted"
            TextChanged="AppSearchBox_TextChanged"
            TextMemberPath="Query">
            <AutoSuggestBox.ItemTemplate>
                <DataTemplate x:DataType="services:SearchHistoryEntry">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="14"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE81C;" />
                        <TextBlock
                            MaxLines="1"
                            Text="{x:Bind Query, Mode=OneTime}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </AutoSuggestBox.ItemTemplate>
        </AutoSuggestBox>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            AlwaysShowHeader="False"
            CompactPaneLength="52"
            IsBackButtonVisible="Collapsed"
            IsPaneOpen="False"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="True"
            ItemInvoked="NavView_ItemInvoked"
            OpenPaneLength="260"
            PaneDisplayMode="LeftCompact"
            SelectionFollowsFocus="Disabled">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="HomeNavItem"
                    Content="Home"
                    Tag="home">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="DiscoverNavItem"
                    Content="Discover"
                    Tag="discover">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Find" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="WatchlistNavItem"
                    Content="Watchlist"
                    Tag="watchlist">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Bookmarks" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="RootFrame" />
        </NavigationView>

        <!--
            The update notice floats above the content instead of taking a row,
            so a download never shifts the page underneath it. It is hidden
            while the player is open.
        -->
        <InfoBar
            x:Name="UpdateBar"
            Grid.Row="1"
            Margin="24"
            MaxWidth="540"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            AutomationProperties.AutomationId="UpdateInfoBar"
            AutomationProperties.Name="Pirsa update"
            IsClosable="True"
            IsOpen="{x:Bind Update.IsOpen, Mode=TwoWay}"
            Message="{x:Bind Update.Message, Mode=OneWay}"
            Severity="{x:Bind Update.Severity, Mode=OneWay}"
            Title="{x:Bind Update.Title, Mode=OneWay}">
            <InfoBar.ActionButton>
                <Button
                    AutomationProperties.AutomationId="UpdateActionButton"
                    AutomationProperties.Name="Download or install the update"
                    Click="UpdateAction_Click"
                    Content="{x:Bind Update.ActionText, Mode=OneWay}"
                    IsEnabled="{x:Bind Update.CanAct, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}"
                    Visibility="{x:Bind helpers:XamlHelpers.Visible(Update.IsActionVisible), Mode=OneWay}" />
            </InfoBar.ActionButton>
            <InfoBar.Content>
                <StackPanel
                    Spacing="6"
                    Visibility="{x:Bind helpers:XamlHelpers.Visible(Update.IsProgressVisible), Mode=OneWay}">
                    <ProgressBar
                        AutomationProperties.Name="Update download progress"
                        IsIndeterminate="{x:Bind Update.IsProgressIndeterminate, Mode=OneWay}"
                        Maximum="100"
                        Value="{x:Bind Update.ProgressValue, Mode=OneWay}" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind Update.ProgressText, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </InfoBar.Content>
        </InfoBar>
    </Grid>
</Window>
